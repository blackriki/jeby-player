<Window x:Class="EmbyPlayer.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:EmbyPlayer.Core;assembly=EmbyPlayer.Core"
        xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls;assembly=EmbyPlayer.UI"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{x:Static core:ApplicationIdentity.Name}"
        Icon="Assets/app-icon.ico"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="700"
        Background="#070B10"
        ResizeMode="CanResize"
        WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome x:Name="MainWindowChrome"
                        CaptionHeight="40"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="WindowCaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#D8DEE7" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CaptionButtonChrome"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#202A35" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#101821" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowCloseCaptionButton"
           TargetType="Button"
           BasedOn="{StaticResource WindowCaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CaptionButtonChrome"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#8E1F14" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="ShellContainer" Margin="0,40,0,0">
      <controls:AppShell x:Name="Shell" />
    </Border>

    <Border x:Name="TitleBar"
            Height="40"
            VerticalAlignment="Top"
            Background="#070B10"
            Panel.ZIndex="100">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Margin="12,0,0,0"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
          <StackPanel Orientation="Horizontal">
            <Image Width="16"
                   Height="16"
                   Source="{Binding Icon, ElementName=RootWindow}"
                   Stretch="Uniform" />
            <TextBlock Margin="9,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#F4F7FB"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{x:Static core:ApplicationIdentity.Name}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Click="OnMinimizeButtonClick"
                  Style="{StaticResource WindowCaptionButton}"
                  ToolTip="最小化"
                  AutomationProperties.Name="最小化">
            <controls:AppIcon Data="{StaticResource Icon.WindowMinimize}"
                              Size="14"
                              StrokeThickness="1.7" />
          </Button>
          <Button Click="OnMaximizeRestoreButtonClick">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
                <Setter Property="ToolTip" Value="最大化" />
                <Setter Property="AutomationProperties.Name" Value="最大化" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WindowState, ElementName=RootWindow}" Value="Maximized">
                    <Setter Property="ToolTip" Value="还原" />
                    <Setter Property="AutomationProperties.Name" Value="还原" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <controls:AppIcon Size="14" StrokeThickness="1.7">
              <controls:AppIcon.Style>
                <Style TargetType="controls:AppIcon"
                       BasedOn="{StaticResource {x:Type controls:AppIcon}}">
                  <Setter Property="Data" Value="{StaticResource Icon.WindowMaximize}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, ElementName=RootWindow}" Value="Maximized">
                      <Setter Property="Data" Value="{StaticResource Icon.WindowRestore}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </controls:AppIcon.Style>
            </controls:AppIcon>
          </Button>
          <Button Click="OnCloseButtonClick"
                  Style="{StaticResource WindowCloseCaptionButton}"
                  ToolTip="关闭"
                  AutomationProperties.Name="关闭">
            <controls:AppIcon Data="{StaticResource Icon.Close}"
                              Size="14"
                              StrokeThickness="1.7" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
