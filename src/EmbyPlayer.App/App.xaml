<Application x:Class="EmbyPlayer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls;assembly=EmbyPlayer.UI"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             ShutdownMode="OnMainWindowClose"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="/EmbyPlayer.UI;component/Resources/Icons.xaml" />
      <ResourceDictionary Source="/EmbyPlayer.UI;component/Styles/IconButtons.xaml" />
      <ResourceDictionary Source="/EmbyPlayer.UI;component/Styles/SettingsPageStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101113" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181B20" />
    <SolidColorBrush x:Key="AccentBrush" Color="#52B54B" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8B0BA" />

    <Style x:Key="AppSearchTextBoxStyle" TargetType="TextBox">
      <Setter Property="Width" Value="360" />
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Background" Value="#151D27" />
      <Setter Property="BorderBrush" Value="#324252" />
      <Setter Property="Foreground" Value="#F4F7FB" />
      <Setter Property="CaretBrush" Value="#F4F7FB" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="0,4,14,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="SearchChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:AppIcon Data="{StaticResource Icon.Search}"
                                  Style="{StaticResource SearchInputIcon}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <TextBlock x:Name="SearchPlaceholder"
                           Grid.Column="1"
                           Text="搜索电影、剧集、演员..."
                           Foreground="#737F8D"
                           FontSize="13"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost"
                              Grid.Column="1"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SearchChrome" Property="BorderBrush" Value="#78D36F" />
                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SearchChrome" Property="BorderBrush" Value="#3A4A5A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AppScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type RepeatButton}">
            <Border Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AppScrollBarThumbStyle" TargetType="{x:Type primitives:Thumb}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type primitives:Thumb}">
            <Border x:Name="ThumbChrome"
                    Margin="2"
                    Background="#3A4552"
                    CornerRadius="4" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbChrome" Property="Background" Value="#4A5665" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbChrome" Property="Background" Value="#52B54B" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ControlTemplate x:Key="AppVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
      <Grid Width="12" Background="{TemplateBinding Background}">
        <Border Width="1"
                HorizontalAlignment="Left"
                Background="#18212B" />
        <primitives:Track x:Name="PART_Track"
                          IsDirectionReversed="True"
                          Maximum="{TemplateBinding Maximum}"
                          Minimum="{TemplateBinding Minimum}"
                          Value="{TemplateBinding Value}"
                          ViewportSize="{TemplateBinding ViewportSize}">
          <primitives:Track.DecreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                          Style="{StaticResource AppScrollBarRepeatButtonStyle}" />
          </primitives:Track.DecreaseRepeatButton>
          <primitives:Track.Thumb>
            <primitives:Thumb Style="{StaticResource AppScrollBarThumbStyle}" />
          </primitives:Track.Thumb>
          <primitives:Track.IncreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                          Style="{StaticResource AppScrollBarRepeatButtonStyle}" />
          </primitives:Track.IncreaseRepeatButton>
        </primitives:Track>
      </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="AppHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
      <Grid Height="12" Background="{TemplateBinding Background}">
        <Border Height="1"
                VerticalAlignment="Top"
                Background="#18212B" />
        <primitives:Track x:Name="PART_Track"
                          IsDirectionReversed="False"
                          Maximum="{TemplateBinding Maximum}"
                          Minimum="{TemplateBinding Minimum}"
                          Value="{TemplateBinding Value}"
                          ViewportSize="{TemplateBinding ViewportSize}">
          <primitives:Track.DecreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                          Style="{StaticResource AppScrollBarRepeatButtonStyle}" />
          </primitives:Track.DecreaseRepeatButton>
          <primitives:Track.Thumb>
            <primitives:Thumb Style="{StaticResource AppScrollBarThumbStyle}" />
          </primitives:Track.Thumb>
          <primitives:Track.IncreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                          Style="{StaticResource AppScrollBarRepeatButtonStyle}" />
          </primitives:Track.IncreaseRepeatButton>
        </primitives:Track>
      </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Background" Value="#070B10" />
      <Setter Property="Template" Value="{StaticResource AppVerticalScrollBarTemplate}" />
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
          <Setter Property="MinHeight" Value="12" />
          <Setter Property="Template" Value="{StaticResource AppHorizontalScrollBarTemplate}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AppSecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#232832" />
      <Setter Property="BorderBrush" Value="#323946" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#2F3742" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#1F5F45" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#171B21" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#252B34" />
                <Setter Property="Foreground" Value="#77818D" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AppPrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppSecondaryButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style x:Key="AppDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppSecondaryButtonStyle}">
      <Setter Property="Background" Value="#3A2024" />
      <Setter Property="BorderBrush" Value="#7D343C" />
      <Setter Property="Foreground" Value="#FFD7DC" />
    </Style>

    <Style x:Key="AppIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppSecondaryButtonStyle}">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="FilterChipButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#181B20" />
      <Setter Property="BorderBrush" Value="#303640" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="FilterChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="FilterChrome" Property="Background" Value="#232A33" />
                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="FilterChrome" Property="Background" Value="#1F5F45" />
                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
                <Setter TargetName="FilterChrome" Property="Background" Value="#1E3928" />
                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="FilterChrome" Property="Background" Value="#171B21" />
                <Setter TargetName="FilterChrome" Property="BorderBrush" Value="#252B34" />
                <Setter Property="Foreground" Value="#77818D" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AppStateCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="#252B34" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="AppStateTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AppStateMessageStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AppStateProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Width" Value="240" />
      <Setter Property="Height" Value="5" />
      <Setter Property="IsIndeterminate" Value="True" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#101318" />
    </Style>

    <Style x:Key="MediaFavoriteBadgeStyle" TargetType="Border">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#CC101318" />
    </Style>

    <Style x:Key="MediaFavoriteBadgeTextStyle" TargetType="TextBlock">
      <Setter Property="Text" Value="&#x2665;" />
      <Setter Property="Foreground" Value="#FF6B81" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MediaPlayedBadgeStyle" TargetType="Border">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="#CC1D2A22" />
    </Style>

    <Style x:Key="MediaPlayedBadgeTextStyle" TargetType="TextBlock">
      <Setter Property="Text" Value="&#x5DF2;&#x770B;" />
      <Setter Property="Foreground" Value="#9FE58A" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MediaCardProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="4" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#303640" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    ClipToBounds="True">
              <Grid x:Name="PART_Track">
                <Rectangle x:Name="PART_Indicator"
                           HorizontalAlignment="Left"
                           Fill="{TemplateBinding Foreground}"
                           RadiusX="3"
                           RadiusY="3" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MediaTypeBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="#26313A" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="MediaTypeBadgeTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B8C0CA" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
