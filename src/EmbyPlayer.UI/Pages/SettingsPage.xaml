<UserControl x:Class="EmbyPlayer.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:EmbyPlayer.Core;assembly=EmbyPlayer.Core"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls"
             Background="{StaticResource SettingsPageBackgroundBrush}"
             MinWidth="900"
             MinHeight="600"
             PreviewKeyDown="OnPagePreviewKeyDown"
             SizeChanged="OnPageSizeChanged">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <Grid x:Name="PageRoot" Background="{StaticResource SettingsPageBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="290" />
      <ColumnDefinition x:Name="LayoutGapColumn" Width="34" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1" />
      </Grid.ColumnDefinitions>
      <Grid Margin="40,18,30,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Command="{Binding NavigateHomeCommand}"
                  Style="{StaticResource SettingsHeaderBackButton}"
                  ToolTip="返回首页"
                  AutomationProperties.Name="返回首页">
            <controls:AppIcon Data="{StaticResource Icon.Back}"
                              Style="{StaticResource NavigationLineIcon}"
                              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <StackPanel Grid.Column="2">
            <TextBlock Text="设置"
                       Foreground="#F4F7FB"
                       FontSize="28"
                       FontWeight="Bold" />
            <TextBlock Text="偏好与本地数据"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource SettingsMutedTextBrush}"
                       FontSize="13" />
          </StackPanel>
        </Grid>

        <TextBox x:Name="SettingsSearchTextBox"
                 Grid.Row="1"
                 Margin="0,14,0,0"
                 Style="{StaticResource SettingsSearchBox}"
                 TextChanged="OnSettingsSearchTextChanged"
                 ToolTip="搜索设置"
                 AutomationProperties.Name="搜索设置"
                 AutomationProperties.HelpText="按名称或说明查找当前设置页面中的项目。" />

        <StackPanel Grid.Row="2" Margin="0,24,0,0">
          <RadioButton x:Name="PlaybackCategoryButton"
                       GroupName="SettingsCategories"
                       Tag="Playback"
                       IsChecked="True"
                       Click="OnCategoryClick"
                       Style="{StaticResource SettingsSidebarItem}"
                       ToolTip="播放设置"
                       AutomationProperties.Name="播放">
            <StackPanel Orientation="Horizontal">
              <controls:AppIcon Data="{StaticResource Icon.Play}"
                                RenderMode="Fill"
                                Style="{StaticResource SettingsSidebarIcon}" />
              <TextBlock Text="播放" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="TracksCategoryButton"
                       GroupName="SettingsCategories"
                       Tag="Tracks"
                       Margin="0,8,0,0"
                       Click="OnCategoryClick"
                       Style="{StaticResource SettingsSidebarItem}"
                       ToolTip="字幕与音轨设置"
                       AutomationProperties.Name="字幕与音轨">
            <StackPanel Orientation="Horizontal">
              <controls:AppIcon Data="{StaticResource Icon.Subtitle}"
                                RenderMode="Stroke"
                                Style="{StaticResource SettingsSidebarIcon}" />
              <TextBlock Text="字幕与音轨" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="AccountCategoryButton"
                       GroupName="SettingsCategories"
                       Tag="Account"
                       Margin="0,8,0,0"
                       Click="OnCategoryClick"
                       Style="{StaticResource SettingsSidebarItem}"
                       ToolTip="服务器与账户"
                       AutomationProperties.Name="服务器与账户">
            <StackPanel Orientation="Horizontal">
              <controls:AppIcon Data="{StaticResource Icon.Server}"
                                RenderMode="Stroke"
                                Style="{StaticResource SettingsSidebarIcon}" />
              <TextBlock Text="服务器与账户" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="LocalDataCategoryButton"
                       GroupName="SettingsCategories"
                       Tag="LocalData"
                       Margin="0,8,0,0"
                       Click="OnCategoryClick"
                       Style="{StaticResource SettingsSidebarItem}"
                       ToolTip="本地数据"
                       AutomationProperties.Name="本地数据">
            <StackPanel Orientation="Horizontal">
              <controls:AppIcon Data="{StaticResource Icon.Database}"
                                RenderMode="Stroke"
                                Style="{StaticResource SettingsSidebarIcon}" />
              <TextBlock Text="本地数据" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="AboutCategoryButton"
                       GroupName="SettingsCategories"
                       Tag="About"
                       Margin="0,8,0,0"
                       Click="OnCategoryClick"
                       Style="{StaticResource SettingsSidebarItem}"
                       ToolTip="关于 Jeby Player"
                       AutomationProperties.Name="关于">
            <StackPanel Orientation="Horizontal">
              <controls:AppIcon Data="{StaticResource Icon.Info}"
                                RenderMode="Stroke"
                                Style="{StaticResource SettingsSidebarIcon}" />
              <TextBlock Text="关于" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="4">
          <TextBlock Text="{x:Static core:ApplicationIdentity.Name}"
                     Foreground="{StaticResource SettingsMutedTextBrush}"
                     FontSize="12" />
          <TextBlock Text="{x:Static core:ApplicationIdentity.Version}"
                     Margin="0,4,0,0"
                     Foreground="{StaticResource SettingsMutedTextBrush}"
                     FontSize="11" />
        </StackPanel>
      </Grid>
      <Border Grid.Column="1" Background="#1D2A35" />
    </Grid>

    <Grid Grid.Column="2">
      <ScrollViewer x:Name="ContentScroller"
                    HorizontalContentAlignment="Stretch"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ContentViewport">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Margin" Value="0,18,32,60" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirty, Mode=OneWay}" Value="True">
                  <Setter Property="Margin" Value="0,18,32,132" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid x:Name="ContentShell"
                Width="{Binding ActualWidth, ElementName=ContentViewport}"
                MaxWidth="980"
                HorizontalAlignment="Left">
          <Grid x:Name="SearchResultsPanel" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="搜索设置" Style="{StaticResource SettingsPageTitle}" />
              <TextBlock x:Name="SearchSummaryText"
                         Text="输入关键词查找设置。"
                         Style="{StaticResource SettingsPageDescription}" />
              <StackPanel x:Name="SearchResultsList" Margin="0,26,0,0" />
              <StackPanel x:Name="NoSearchResultsPanel"
                          Margin="0,100,0,0"
                          HorizontalAlignment="Center"
                          Visibility="Collapsed">
                <controls:AppIcon Data="{StaticResource Icon.Search}"
                                  RenderMode="Stroke"
                                  Size="32"
                                  Foreground="{StaticResource SettingsMutedTextBrush}" />
                <TextBlock Text="没有找到相关设置"
                           Margin="0,14,0,0"
                           Foreground="#F4F7FB"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="试试更短的关键词。"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource SettingsMutedTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="PlaybackPanel">
            <StackPanel>
              <TextBlock Text="播放" Style="{StaticResource SettingsPageTitle}" />
              <TextBlock Text="控制播放器启动、音量和控制层行为的基础偏好。"
                         Style="{StaticResource SettingsPageDescription}" />
              <StackPanel Margin="0,30,0,0">
                <TextBlock Text="播放行为" Style="{StaticResource SettingsGroupTitle}" />
                <TextBlock Text="这些设置会在下一次播放任务中生效。"
                           Style="{StaticResource SettingsPageDescription}" />
                <Border Width="36"
                        Height="2"
                        Margin="0,9,0,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1" />
              </StackPanel>
              <Border Style="{StaticResource SettingsSurface}">
                <StackPanel>
                  <Border Style="{StaticResource SettingsFirstRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="自动播放下一集" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="当前单集自然播放结束后，自动进入下一集。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ToggleButton x:Name="AutoNextToggle"
                                    Grid.Column="1"
                                    IsChecked="{Binding AutoPlayNextEpisode, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggle}"
                                    ToolTip="自动播放下一集"
                                    AutomationProperties.Name="自动播放下一集"
                                    AutomationProperties.AutomationId="AutoPlayNextEpisodeCheckBox"
                                    AutomationProperties.HelpText="切换自动播放下一集设置。" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="记住上次音量" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="下次播放时沿用最近一次调整后的音量。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ToggleButton x:Name="RememberVolumeToggle"
                                    Grid.Column="1"
                                    IsChecked="{Binding RememberLastVolume, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggle}"
                                    ToolTip="记住上次音量"
                                    AutomationProperties.Name="记住上次音量" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="默认音量" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="首次播放、没有历史音量，或未启用记忆音量时使用。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <Grid Grid.Column="1" Width="340">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <controls:SettingsSlider x:Name="DefaultVolumeSlider"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding DefaultVolume, Mode=TwoWay}"
                                                 TickFrequency="1"
                                                 Style="{StaticResource SettingsSlider}"
                                                 ToolTip="默认音量"
                                                 AutomationProperties.Name="默认音量" />
                        <TextBlock x:Name="DefaultVolumeText"
                                   Grid.Column="2"
                                   Text="{Binding DefaultVolume, Mode=OneWay, StringFormat={}{0}%}"
                                   Foreground="#F4F7FB"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextAlignment="Right" />
                      </Grid>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="快进 / 快退步长" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="左右方向键每次前进或后退使用同一个秒数。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ComboBox x:Name="SeekSecondsComboBox"
                                Grid.Column="1"
                                ItemsSource="{Binding SeekSecondsOptions, Mode=OneWay}"
                                SelectedItem="{Binding SeekSeconds, Mode=TwoWay}"
                                Style="{StaticResource SettingsComboBox}"
                                ToolTip="快进和快退步长"
                                AutomationProperties.Name="快进和快退步长">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} 秒}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="控制栏自动隐藏" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="停止操作后等待指定时间隐藏播放器控制层。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ComboBox x:Name="ControlsHideComboBox"
                                Grid.Column="1"
                                ItemsSource="{Binding ControlsHideSecondsOptions, Mode=OneWay}"
                                SelectedItem="{Binding ControlsHideSeconds, Mode=TwoWay}"
                                Style="{StaticResource SettingsComboBox}"
                                ToolTip="控制栏自动隐藏时间"
                                AutomationProperties.Name="控制栏自动隐藏时间">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding StringFormat={}{0} 秒}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
              <StackPanel x:Name="ShortcutSettingsPanel" DataContext="{Binding Shortcuts}" Margin="0,28,0,0">
                <TextBlock Text="播放器快捷键" Style="{StaticResource SettingsGroupTitle}" />
                <TextBlock Text="点击按键后录入新组合，可使用 Ctrl、Shift、Alt。Esc 保留用于退出或取消，Tab 与系统快捷键不可分配。保存后下次播放生效。"
                           Style="{StaticResource SettingsPageDescription}" TextWrapping="Wrap" Margin="0,8,0,14" />
                <Button Content="恢复默认快捷键" Command="{Binding RestoreDefaultsCommand}" HorizontalAlignment="Left"
                        Style="{StaticResource SettingsButton}" Margin="0,0,0,14" AutomationProperties.Name="恢复默认快捷键" />
                <Border Style="{StaticResource SettingsSurface}">
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SettingsRow}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="225" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap"
                                       Style="{StaticResource SettingsRowTitle}" />
                            <Button Grid.Column="1" Content="{Binding ButtonText}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.CaptureCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    LostKeyboardFocus="OnShortcutCaptureLostFocus" AutomationProperties.Name="{Binding AutomationName}">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.ClearCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Style="{StaticResource SettingsButton}" AutomationProperties.Name="{Binding Label, StringFormat=清除{0}快捷键}" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding ErrorMessage}" Foreground="#FF9A9A"
                                       Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="TracksPanel" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="字幕与音轨" Style="{StaticResource SettingsPageTitle}" />
              <TextBlock Text="设置默认字幕和音轨；连续播放同一电视剧时，优先沿用上次手动选择。"
                         Style="{StaticResource SettingsPageDescription}" />
              <StackPanel Margin="0,30,0,0">
                <TextBlock Text="语言偏好" Style="{StaticResource SettingsGroupTitle}" />
                <TextBlock Text="“自动”沿用播放器选择。关闭默认字幕后，仍可在播放时手动开启。"
                           Style="{StaticResource SettingsPageDescription}" />
                <Border Width="36"
                        Height="2"
                        Margin="0,9,0,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1" />
              </StackPanel>
              <Border Style="{StaticResource SettingsSurface}">
                <StackPanel>
                  <Border Style="{StaticResource SettingsFirstRow}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="默认开启字幕" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="新媒体按语言偏好选择字幕；关闭时不显示可切换字幕。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ToggleButton x:Name="DefaultSubtitlesToggle" Grid.Column="1"
                                    IsChecked="{Binding DefaultSubtitlesEnabled, Mode=TwoWay}"
                                    Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                    AutomationProperties.Name="默认开启字幕" AutomationProperties.AutomationId="Settings.DefaultSubtitles" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="默认字幕语言" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="优先选择与该语言匹配的字幕；无法匹配时继续使用现有回退。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ComboBox x:Name="SubtitleLanguageComboBox"
                                Grid.Column="1"
                                Width="206"
                                ItemsSource="{Binding SubtitleLanguageOptions, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding DefaultSubtitleLanguage, Mode=TwoWay}"
                                Style="{StaticResource SettingsComboBox}"
                                ToolTip="默认字幕语言"
                                AutomationProperties.Name="默认字幕语言" />
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="默认音轨语言" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="优先选择与该语言匹配的音轨。"
                                   Style="{StaticResource SettingsRowDescription}" />
                      </StackPanel>
                      <ComboBox x:Name="AudioLanguageComboBox"
                                Grid.Column="1"
                                Width="206"
                                ItemsSource="{Binding AudioLanguageOptions, Mode=OneWay}"
                                DisplayMemberPath="DisplayName"
                                SelectedValuePath="Value"
                                SelectedValue="{Binding DefaultAudioLanguage, Mode=TwoWay}"
                                Style="{StaticResource SettingsComboBox}"
                                ToolTip="默认音轨语言"
                                AutomationProperties.Name="默认音轨语言" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="AccountPanel" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="服务器与账户" Style="{StaticResource SettingsPageTitle}" />
              <TextBlock Text="查看当前连接，并执行账户级操作。"
                         Style="{StaticResource SettingsPageDescription}" />
              <StackPanel Margin="0,30,0,0">
                <TextBlock Text="当前连接" Style="{StaticResource SettingsGroupTitle}" />
                <Border Width="36"
                        Height="2"
                        Margin="0,9,0,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1" />
              </StackPanel>
              <Border Padding="34,28" Style="{StaticResource SettingsEmphasisSurface}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64"
                            Height="64"
                            Background="#1D3A25"
                            BorderBrush="#315D3A"
                            BorderThickness="1"
                            CornerRadius="32">
                      <controls:AppIcon Data="{StaticResource Icon.Account}"
                                        RenderMode="Stroke"
                                        Size="30"
                                        Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding UserDisplayName, Mode=OneWay, FallbackValue=Riki}"
                                 Foreground="#F4F7FB"
                                 FontSize="22"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="当前登录账户"
                                 Margin="0,5,0,0"
                                 Foreground="#A6B1BE"
                                 FontSize="13" />
                    </StackPanel>
                    <Border Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource SettingsStatusBadge}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,8,0"
                                 Fill="#8DEB84" />
                        <TextBlock Text="已连接"
                                   Foreground="#8DEB84"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Border Margin="0,24,0,0"
                          Padding="0,24,0,0"
                          BorderBrush="#2B3946"
                          BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="服务器地址"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding CurrentServerText, Mode=OneWay, FallbackValue=https://media.example.local}"
                                   Margin="0,7,20,0"
                                   Foreground="#F4F7FB"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="登录账户"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   FontSize="12" />
                        <TextBlock Text="{Binding UserDisplayName, Mode=OneWay, FallbackValue=Riki}"
                                   Margin="0,7,0,0"
                                   Foreground="#F4F7FB"
                                   FontWeight="SemiBold" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Margin="0,26,0,0" Orientation="Horizontal">
                    <Button Command="{Binding RequestSwitchServerCommand}"
                            Style="{StaticResource SettingsButton}"
                            ToolTip="清除当前登录状态并连接其他服务器"
                            AutomationProperties.Name="切换服务器"
                            AutomationProperties.HelpText="确认后清除当前登录状态和服务器地址，并返回服务器连接页面。">
                      <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Data="{StaticResource Icon.Server}"
                                          RenderMode="Stroke"
                                          Style="{StaticResource SettingsButtonIcon}" />
                        <TextBlock Text="切换服务器" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Margin="10,0,0,0"
                            Command="{Binding RequestLogoutCommand}"
                            Style="{StaticResource SettingsDangerButton}"
                            ToolTip="退出当前账户"
                            AutomationProperties.Name="退出登录"
                            AutomationProperties.HelpText="确认后清除当前账户登录状态并返回登录页面。">
                      <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Data="{StaticResource Icon.Logout}"
                                          RenderMode="Stroke"
                                          Style="{StaticResource SettingsButtonIcon}" />
                        <TextBlock Text="退出登录" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Border>
              <StackPanel Margin="0,30,0,0">
                <TextBlock Text="服务器媒体库" Style="{StaticResource SettingsGroupTitle}" />
                <Border Width="36"
                        Height="2"
                        Margin="0,9,0,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1" />
              </StackPanel>
              <Border Style="{StaticResource SettingsSurface}">
                <StackPanel>
                  <Border Style="{StaticResource SettingsFirstRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="扫描媒体库" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="请求 Emby 服务器扫描媒体文件。此操作需要服务器管理员权限，提交后由服务器在后台执行。"
                                   Style="{StaticResource SettingsRowDescription}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Command="{Binding ScanMediaLibraryCommand}"
                              Style="{StaticResource SettingsButton}"
                              ToolTip="请求 Emby 服务器扫描媒体文件"
                              AutomationProperties.Name="扫描媒体库"
                              AutomationProperties.HelpText="向 Emby 服务器提交媒体库扫描请求。需要服务器管理员权限。">
                        <StackPanel Orientation="Horizontal">
                          <controls:AppIcon Data="{StaticResource Icon.Retry}"
                                            RenderMode="Stroke"
                                            Style="{StaticResource SettingsButtonIcon}" />
                          <TextBlock Text="{Binding MediaLibraryScanButtonText, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding LibraryScanMessage, Mode=OneWay}"
                             Visibility="{Binding HasLibraryScanMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="24,0,24,20"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="LocalDataPanel" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="本地数据" Style="{StaticResource SettingsPageTitle}" />
              <TextBlock Text="管理仅保存在这台电脑上的历史、索引与诊断文件。"
                         Style="{StaticResource SettingsPageDescription}" />
              <StackPanel Margin="0,30,0,0">
                <TextBlock Text="本地维护" Style="{StaticResource SettingsGroupTitle}" />
                <Border Width="36"
                        Height="2"
                        Margin="0,9,0,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1" />
              </StackPanel>
              <Border Style="{StaticResource SettingsSurface}">
                <StackPanel>
                  <Border Style="{StaticResource SettingsFirstRow}">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="搜索历史" Style="{StaticResource SettingsRowTitle}" />
                      <TextBlock Text="最近搜索记录保存在本机，可在搜索页管理或清除。"
                                 Style="{StaticResource SettingsRowDescription}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="诊断日志" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="导出项目日志的脱敏副本，不包含设置、登录凭据、缓存或媒体文件。"
                                   Style="{StaticResource SettingsRowDescription}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding DiagnosticExportMessage, Mode=OneWay}"
                                   Visibility="{Binding HasDiagnosticExportMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              VerticalAlignment="Center"
                              Command="{Binding ExportDiagnosticLogsCommand}"
                              Style="{StaticResource SettingsButton}"
                              ToolTip="选择 ZIP 文件的保存位置"
                              AutomationProperties.Name="导出诊断日志"
                              AutomationProperties.HelpText="创建经过脱敏处理的诊断日志压缩包。">
                        <TextBlock Text="{Binding DiagnosticExportButtonText, Mode=OneWay}" />
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <StackPanel x:Name="CacheManagementPanel" DataContext="{Binding CacheManagement}" Margin="0,24,0,0">
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="缓存与索引" Style="{StaticResource SettingsGroupTitle}" VerticalAlignment="Center" />
                  <Button Command="{Binding RefreshUsageCommand}" HorizontalAlignment="Right"
                          Style="{StaticResource SettingsButton}" AutomationProperties.Name="刷新缓存占用">
                    <StackPanel Orientation="Horizontal">
                      <controls:AppIcon Data="{StaticResource Icon.Refresh}" RenderMode="Stroke" Size="16" Margin="0,0,7,0" />
                      <TextBlock Text="刷新占用" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Style="{StaticResource SettingsSurface}">
                  <StackPanel>
                    <Border Style="{StaticResource SettingsFirstRow}">
                      <StackPanel>
                        <TextBlock Text="图片缓存" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="海报与背景图临时保存在内存，清理后会按需重新加载。"
                                   Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ImageUsageText, Mode=OneWay}" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Button Content="清理图片缓存" Command="{Binding ClearImagesCommand}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Style="{StaticResource SettingsButton}"
                                AutomationProperties.Name="清理图片缓存" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsRow}">
                      <StackPanel>
                        <TextBlock Text="本地搜索索引" Style="{StaticResource SettingsRowTitle}" />
                        <TextBlock Text="索引保存在本机并加载到内存用于搜索。清理会同时移除磁盘文件和内存索引。"
                                   Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SearchIndexUsageText, Mode=OneWay}" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <WrapPanel Margin="0,12,0,0">
                          <Button Content="清理索引" Command="{Binding ClearSearchIndexCommand}" Margin="0,0,10,0"
                                  Style="{StaticResource SettingsButton}" AutomationProperties.Name="清理搜索索引" />
                          <Button Content="重建当前账户索引" Command="{Binding RebuildSearchIndexCommand}"
                                  Style="{StaticResource SettingsButton}" AutomationProperties.Name="重建搜索索引" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <controls:LoadingSpinner Width="18" Height="18" Margin="0,0,9,0" />
                  <TextBlock Text="正在处理缓存..." Foreground="{StaticResource TextSecondaryBrush}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9A9A" TextWrapping="Wrap" />
                  <Button Content="重试" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                          Style="{StaticResource SettingsButton}" AutomationProperties.Name="重试缓存操作" />
                </StackPanel>
                <Border Margin="0,16,0,0" Padding="20" Style="{StaticResource SettingsEmphasisSurface}"
                        Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}" Style="{StaticResource SettingsRowTitle}" />
                    <TextBlock Text="{Binding ConfirmationMessage}" Style="{StaticResource SettingsRowDescription}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="确认" Command="{Binding ConfirmCommand}" Margin="0,0,10,0"
                              Style="{StaticResource SettingsButton}" AutomationProperties.Name="确认缓存操作" />
                      <Button x:Name="CacheCancelButton" Content="取消" Command="{Binding CancelConfirmationCommand}"
                              Style="{StaticResource SettingsButton}" AutomationProperties.Name="取消缓存操作" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="AboutPanel" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="关于" Style="{StaticResource SettingsPageTitle}" />
              <TextBlock Text="查看应用版本与构建信息。"
                         Style="{StaticResource SettingsPageDescription}" />
              <StackPanel Margin="0,30,0,0">
                <TextBlock Text="{x:Static core:ApplicationIdentity.Name}" Style="{StaticResource SettingsGroupTitle}" />
                <Border Width="36"
                        Height="2"
                        Margin="0,9,0,10"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="1" />
              </StackPanel>
              <Border MinHeight="196"
                      Padding="34,38,34,28"
                      Style="{StaticResource SettingsEmphasisSurface}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="64"
                           Height="64"
                           Source="/EmbyPlayer.UI;component/Assets/app-icon.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="{x:Static core:ApplicationIdentity.Name}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{x:Static core:ApplicationIdentity.Name}"
                                 Foreground="#F4F7FB"
                                 FontSize="22"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="适用于 Windows 的 Emby 桌面播放器。"
                                 Margin="0,6,0,0"
                                 Foreground="#A6B1BE"
                                 FontSize="13" />
                      <TextBlock Text="独立第三方客户端，与 Emby 官方无隶属关系。"
                                 Margin="0,6,0,0"
                                 Foreground="{StaticResource SettingsMutedTextBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="项目许可：GPL-3.0-or-later；第三方组件遵循各自许可。"
                                 Margin="0,6,0,0"
                                 Foreground="{StaticResource SettingsMutedTextBrush}"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Border Grid.Row="1"
                          Margin="0,24,0,0"
                          Padding="0,24,0,0"
                          BorderBrush="#2B3946"
                          BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="版本"
                                 Foreground="{StaticResource SettingsMutedTextBrush}"
                                 FontSize="12" />
                      <TextBlock Grid.Column="1"
                                 Text="{x:Static core:ApplicationIdentity.Version}"
                                 Foreground="#F4F7FB" />
                      <TextBlock Grid.Row="1"
                                 Text="构建"
                                 Margin="0,12,0,0"
                                 Foreground="{StaticResource SettingsMutedTextBrush}"
                                 FontSize="12" />
                      <TextBlock Grid.Row="1" Grid.Column="1"
                                 Text="{x:Static core:ApplicationIdentity.Build}"
                                 ToolTip="{x:Static core:ApplicationIdentity.FullVersion}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,12,0,0"
                                 Foreground="#A6B1BE" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Border x:Name="UnsavedBar"
            Grid.Column="2"
            MinHeight="68"
            Width="{Binding ActualWidth, ElementName=ContentViewport}"
            MaxWidth="980"
            Margin="0,0,32,26"
            Padding="24,12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{StaticResource SettingsEmphasisSurfaceBrush}"
            BorderBrush="#3D4E5D"
            BorderThickness="0,1,0,0"
            CornerRadius="12"
            Visibility="{Binding IsDirty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30"
                          Opacity="0.34"
                          ShadowDepth="12" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8"
                   Height="8"
                   Margin="0,0,14,0"
                   Fill="{StaticResource AccentBrush}" />
          <StackPanel>
            <TextBlock x:Name="UnsavedTitle"
                       Text="{Binding UnsavedTitle, Mode=OneWay}"
                       Foreground="#F4F7FB"
                       FontSize="15"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="UnsavedDetail"
                       Text="{Binding UnsavedDetail, Mode=OneWay}"
                       Margin="0,3,0,0"
                       Foreground="#737F8D"
                       FontSize="12" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Command="{Binding RestoreDefaultsCommand}"
                  Style="{StaticResource SettingsButton}"
                  ToolTip="恢复默认"
                  AutomationProperties.Name="恢复默认">
            <TextBlock Text="恢复默认" />
          </Button>
          <Button x:Name="SaveButton"
                  Margin="12,0,0,0"
                  Command="{Binding RetrySaveCommand}"
                  Style="{StaticResource SettingsPrimaryButton}"
                  ToolTip="保存更改"
                  AutomationProperties.Name="保存更改">
            <StackPanel Orientation="Horizontal">
              <controls:LoadingSpinner x:Name="SaveSpinner"
                                       Width="18"
                                       Height="18"
                                       Margin="0,0,9,0"
                                       Visibility="{Binding IsSaving, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <TextBlock x:Name="SaveButtonText"
                         Text="{Binding SaveButtonText, Mode=OneWay}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>

        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="DialogOverlay"
            Grid.ColumnSpan="3"
            Background="#C9000408"
            Visibility="{Binding IsAnyDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Border Width="472"
              Padding="28,28,28,30"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="{StaticResource SettingsEmphasisSurfaceBrush}"
              BorderBrush="#42515F"
              BorderThickness="1"
              CornerRadius="15">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Border Width="44"
                    Height="44"
                    Background="{StaticResource SettingsDangerSurfaceBrush}"
                    BorderBrush="#763640"
                    BorderThickness="1"
                    CornerRadius="22">
              <Grid>
                <controls:AppIcon Data="{StaticResource Icon.Reset}"
                                  RenderMode="Stroke"
                                  Size="20"
                                  Foreground="{StaticResource SettingsDangerBrush}"
                                  Visibility="{Binding IsRestoreDefaultsDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:AppIcon Data="{StaticResource Icon.Error}"
                                  RenderMode="Stroke"
                                  Size="20"
                                  Foreground="{StaticResource SettingsDangerBrush}"
                                  Visibility="{Binding IsUnsavedLeaveDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:AppIcon Data="{StaticResource Icon.Logout}"
                                  RenderMode="Stroke"
                                  Size="20"
                                  Foreground="{StaticResource SettingsDangerBrush}"
                                  Visibility="{Binding IsLogoutDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <controls:AppIcon Data="{StaticResource Icon.Server}"
                                  RenderMode="Stroke"
                                  Size="20"
                                  Foreground="{StaticResource SettingsDangerBrush}"
                                  Visibility="{Binding IsSwitchServerDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </Grid>
            </Border>
            <TextBlock x:Name="DialogTitle"
                       Grid.Column="2"
                       Text="{Binding DialogTitle, Mode=OneWay}"
                       Foreground="#F4F7FB"
                       FontSize="21"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="3"
                    Width="36"
                    Height="36"
                    MinWidth="0"
                    Padding="0"
                    Command="{Binding CancelDialogCommand}"
                    IsEnabled="{Binding IsDialogCancelEnabled, Mode=OneWay}"
                    Style="{StaticResource SettingsButton}"
                    ToolTip="关闭"
                    AutomationProperties.Name="关闭确认窗口">
              <controls:AppIcon Data="{StaticResource Icon.Close}"
                                RenderMode="Stroke"
                                Size="16" />
            </Button>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock x:Name="DialogMessage"
                       Text="{Binding DialogMessage, Mode=OneWay}"
                       Foreground="#A6B1BE"
                       FontSize="14"
                       LineHeight="23"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding DialogDetail, Mode=OneWay}"
                       Margin="0,8,0,0"
                       Foreground="#737F8D"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding AccountActionErrorMessage, Mode=OneWay}"
                       Visibility="{Binding HasAccountActionError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,12,0,0"
                       Foreground="#FF8585"
                       FontSize="13"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Margin="0,30,0,0"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal"
                      Visibility="{Binding IsRestoreDefaultsDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button x:Name="RestoreCancelButton"
                    Command="{Binding CancelRestoreDefaultsCommand}"
                    Style="{StaticResource SettingsButton}"
                    ToolTip="取消"
                    AutomationProperties.Name="取消">
              <TextBlock Text="取消" />
            </Button>
            <Button x:Name="DialogConfirmButton"
                    Margin="10,0,0,0"
                    Command="{Binding ConfirmRestoreDefaultsCommand}"
                    Style="{StaticResource SettingsDangerButton}"
                    ToolTip="确认恢复默认"
                    AutomationProperties.Name="确认恢复默认">
              <TextBlock x:Name="DialogConfirmText" Text="恢复默认" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Margin="0,30,0,0"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal"
                      Visibility="{Binding IsUnsavedLeaveDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button x:Name="ContinueEditingButton"
                    Command="{Binding ContinueEditingCommand}"
                    Style="{StaticResource SettingsButton}"
                    ToolTip="继续编辑"
                    AutomationProperties.Name="继续编辑">
              <TextBlock Text="继续编辑" />
            </Button>
            <Button Margin="10,0,0,0"
                    Command="{Binding DiscardChangesCommand}"
                    Style="{StaticResource SettingsDangerButton}"
                    ToolTip="放弃未保存的更改"
                    AutomationProperties.Name="放弃更改">
              <TextBlock Text="放弃更改" />
            </Button>
            <Button Margin="10,0,0,0"
                    Command="{Binding SaveAndLeaveCommand}"
                    Style="{StaticResource SettingsPrimaryButton}"
                    ToolTip="保存并离开设置"
                    AutomationProperties.Name="保存并离开">
              <TextBlock Text="保存并离开" />
            </Button>
          </StackPanel>
          <StackPanel Grid.Row="2"
                      Margin="0,30,0,0"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal"
                      Visibility="{Binding IsAccountActionDialogOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button x:Name="AccountActionCancelButton"
                    Command="{Binding CancelDialogCommand}"
                    IsEnabled="{Binding IsDialogCancelEnabled, Mode=OneWay}"
                    Style="{StaticResource SettingsButton}"
                    ToolTip="取消"
                    AutomationProperties.Name="取消账户操作">
              <TextBlock Text="取消" />
            </Button>
            <Button Margin="10,0,0,0"
                    Command="{Binding ConfirmAccountActionCommand}"
                    Style="{StaticResource SettingsDangerButton}"
                    ToolTip="确认账户操作"
                    AutomationProperties.Name="{Binding AccountActionConfirmText, Mode=OneWay}">
              <TextBlock Text="{Binding AccountActionConfirmText, Mode=OneWay}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="Toast"
            Grid.ColumnSpan="3"
            MinHeight="46"
            Margin="0,0,28,28"
            Padding="18,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#17241B"
            BorderBrush="#315D3A"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{Binding IsToastVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <controls:AppIcon Data="{StaticResource Icon.Watched}"
                          RenderMode="Fill"
                          Size="17"
                          Margin="0,0,10,0"
                          Foreground="{StaticResource AccentBrush}" />
        <TextBlock x:Name="ToastText"
                   Text="{Binding ToastMessage, Mode=OneWay}"
                   Foreground="#F4F7FB"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
