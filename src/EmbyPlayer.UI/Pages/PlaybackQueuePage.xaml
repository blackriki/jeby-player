<UserControl x:Class="EmbyPlayer.UI.Pages.PlaybackQueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls"
             x:Name="QueuePageRoot" Background="{StaticResource AppBackgroundBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="QueueVisibility" />
    <Style x:Key="QueueAction" TargetType="Button" BasedOn="{StaticResource AppSecondaryButtonStyle}">
      <Setter Property="MinWidth" Value="32" /><Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <Button x:Name="QueueBackButton" Content="返回" Command="{Binding BackCommand}"
              HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.AutomationId="Queue.Back">
        <Button.Style>
          <Style TargetType="Button" BasedOn="{StaticResource PageBackButton}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEmbedded, ElementName=QueuePageRoot}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>
      <TextBlock Text="播放队列" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="{Binding SummaryText}" Margin="0,7,0,18" Foreground="{StaticResource TextSecondaryBrush}" />
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <ToggleButton x:Name="QueueAutoPlayToggle" IsChecked="{Binding AutoPlayEnabled, Mode=TwoWay}"
                        IsEnabled="{Binding CanEdit}" Style="{StaticResource SettingsToggle}"
                        AutomationProperties.AutomationId="Queue.AutoPlay" AutomationProperties.Name="队列自动连播" />
          <TextBlock Text="自动连播" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>
        <Button Content="清空待播" Command="{Binding ClearPendingCommand}" DockPanel.Dock="Right"
                Style="{StaticResource AppSecondaryButtonStyle}" AutomationProperties.AutomationId="Queue.ClearPending" />
      </DockPanel>
      <TextBlock Text="正在准备播放…" Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                 Visibility="{Binding IsBusy, Converter={StaticResource QueueVisibility}}" />
      <TextBlock Text="{Binding ErrorMessage}" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                 AutomationProperties.AutomationId="Queue.Error"
                 Visibility="{Binding HasError, Converter={StaticResource QueueVisibility}}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="QueueScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,10,0">
        <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource QueueVisibility}}" Margin="0,36,0,36">
          <TextBlock Text="队列还是空的" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding EmptyMessage}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasCurrent, Converter={StaticResource QueueVisibility}}" Margin="0,0,0,24">
          <TextBlock Text="当前项目" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,0,10" />
          <Border Background="{StaticResource SurfaceBrush}" Padding="12" CornerRadius="6">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <controls:RoundedClipBorder Width="52" Height="76" CornerRadius="4">
                <controls:AuthenticatedImage ImageUrl="{Binding CurrentItem.ImageUrl}" PlaceholderText="影片" Stretch="UniformToFill" />
              </controls:RoundedClipBorder>
              <TextBlock Grid.Column="1" Text="{Binding CurrentItem.Title}" ToolTip="{Binding CurrentItem.Title}"
                         Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="16"
                         Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.AutomationId="Queue.CurrentTitle" />
            </Grid>
          </Border>
        </StackPanel>
        <TextBlock Text="接下来播放" Margin="0,0,0,12" Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding HasPending, Converter={StaticResource QueueVisibility}}" />
        <TextBlock Text="待播项目已播完，可继续加入影片或单集。" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding IsPendingEmpty, Converter={StaticResource QueueVisibility}}" />
        <ItemsControl x:Name="QueueItems" ItemsSource="{Binding PendingItems}" AutomationProperties.AutomationId="Queue.Pending">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{StaticResource SurfaceBrush}" Padding="10" Margin="0,0,0,8" CornerRadius="6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource MediaSurfaceCardButtonStyle}" Padding="0" HorizontalContentAlignment="Stretch"
                          Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" ToolTip="{Binding Title}"
                          AutomationProperties.AutomationId="Queue.Play" AutomationProperties.Name="{Binding Title}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <controls:RoundedClipBorder Width="42" Height="62" CornerRadius="4">
                        <controls:AuthenticatedImage ImageUrl="{Binding ImageUrl}" PlaceholderText="影片" Stretch="UniformToFill" />
                      </controls:RoundedClipBorder>
                      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding MetadataText}" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="66" Height="32" Margin="4,0,0,0" Padding="8,0,6,0" Style="{StaticResource SettingsComboBox}"
                              ItemsSource="{Binding DataContext.PositionOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding Position, Mode=OneWay}" SelectionChanged="OnPositionChanged"
                              IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              ToolTip="移动到指定位置" AutomationProperties.AutomationId="Queue.Position" AutomationProperties.Name="移动到指定位置" />
                    <Button Content="↑" Style="{StaticResource QueueAction}" ToolTip="上移"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" AutomationProperties.AutomationId="Queue.MoveUp" AutomationProperties.Name="上移" />
                    <Button Content="↓" Style="{StaticResource QueueAction}" ToolTip="下移"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" AutomationProperties.AutomationId="Queue.MoveDown" AutomationProperties.Name="下移" />
                    <Button Content="×" Style="{StaticResource QueueAction}" ToolTip="移除待播项目"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" AutomationProperties.AutomationId="Queue.Remove" AutomationProperties.Name="移除待播项目" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
