<UserControl x:Class="EmbyPlayer.UI.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls"
             xmlns:local="clr-namespace:EmbyPlayer.UI.Pages"
             xmlns:library="clr-namespace:EmbyPlayer.Core.Library;assembly=EmbyPlayer.Core"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             PreviewMouseDown="OnPreviewMouseDown"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <local:LibraryQueryOptionConverter x:Key="QueryOptionConverter" />
    <system:Boolean x:Key="AllFavorites">False</system:Boolean>
    <system:Boolean x:Key="OnlyFavorites">True</system:Boolean>
    <system:Double x:Key="LibraryPosterWidth">168</system:Double>
    <Thickness x:Key="LibraryPosterMargin">0,0,16,22</Thickness>
    <local:LibraryContentWidthConverter x:Key="LibraryContentWidthConverter"
                                       CardWidth="{StaticResource LibraryPosterWidth}"
                                       CardMargin="{StaticResource LibraryPosterMargin}" />

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,24,0,14" />
    </Style>

    <Style x:Key="RetryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AppPrimaryButtonStyle}">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="18,10" />
    </Style>

    <Style x:Key="LibraryToolbarButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FocusVisualStyle">
        <Setter.Value>
          <Style TargetType="Control">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Control">
                  <Border BorderBrush="{StaticResource SettingsFocusBrush}" BorderThickness="0,0,0,2" Margin="12,6" />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SettingsFocusBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SettingsFocusBrush}" />
              </DataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryQueryMenuItem" TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <EventSetter Event="Click" Handler="OnQueryOptionClick" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                <controls:AppIcon x:Name="SelectionMark" Grid.Column="1" Data="{StaticResource Icon.Check}"
                                  RenderMode="Stroke" Size="16" Foreground="{StaticResource SettingsFocusBrush}"
                                  HorizontalAlignment="Right" Visibility="Hidden" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryQueryMenuHeading" TargetType="MenuItem" BasedOn="{StaticResource LibraryQueryMenuItem}">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <ContentPresenter ContentSource="Header" Margin="13,8,12,4" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryQueryMenu" TargetType="ContextMenu">
      <Setter Property="DataContext" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
      <Setter Property="IsEnabled" Value="{Binding CanChangeQuery}" />
      <Setter Property="Placement" Value="Bottom" />
      <Setter Property="VerticalOffset" Value="6" />
      <Setter Property="MinWidth" Value="208" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource LibraryQueryMenuItem}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SettingsDividerBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="5">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="Opened" Handler="OnQueryMenuOpened" />
      <EventSetter Event="Closed" Handler="OnQueryMenuClosed" />
    </Style>

    <Style x:Key="LibraryQueryMenuSeparator" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="12,5" Background="{StaticResource SettingsDividerBrush}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="176" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Background" Value="#181B20" />
      <Setter Property="BorderBrush" Value="#252B34" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="LibraryChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LibraryChrome" Property="Background" Value="#20242B" />
                <Setter TargetName="LibraryChrome" Property="BorderBrush" Value="#52B54B" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="LibraryChrome" Property="BorderBrush" Value="#52B54B" />
                <Setter TargetName="LibraryChrome" Property="Background" Value="#1E2922" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PosterButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="{StaticResource LibraryPosterWidth}" />
      <Setter Property="Margin" Value="{StaticResource LibraryPosterMargin}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#181B20" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <controls:RoundedClipBorder x:Name="CardChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
              <ContentPresenter />
            </controls:RoundedClipBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CardChrome" Property="Background" Value="#20242B" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="CardChrome" Property="Background" Value="#243029" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <controls:PageStateView Grid.RowSpan="2"
                            IsLoading="{Binding IsInitialLibrariesLoading, Mode=OneWay}"
                            HasError="{Binding IsLibraryErrorVisible, Mode=OneWay}"
                            ErrorMessage="{Binding LibraryErrorMessage, Mode=OneWay}"
                            LoadingMessage="&#x6B63;&#x5728;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x5E93;..."
                            ErrorTitle="&#x5A92;&#x4F53;&#x5E93;&#x52A0;&#x8F7D;&#x5931;&#x8D25;"
                            ErrorHint="&#x8BF7;&#x68C0;&#x67E5;&#x7F51;&#x7EDC;&#x6216;&#x670D;&#x52A1;&#x5668;&#x72B6;&#x6001;&#x540E;&#x91CD;&#x8BD5;&#x3002;"
                            ErrorIcon="{StaticResource Icon.Error}"
                            RetryCommand="{Binding RetryCommand}"
                            RetryToolTip="&#x91CD;&#x65B0;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x5E93;"
                            RetryAutomationName="&#x91CD;&#x8BD5;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x5E93;" />

    <Border x:Name="FixedBackScrim"
            Grid.RowSpan="2"
            Visibility="{Binding IsLibrariesContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
            Style="{StaticResource FixedPageBackScrim}" />

    <Grid x:Name="FixedPageHeader"
          Grid.Row="0"
          Visibility="{Binding IsLibrariesContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
          Margin="34,28,34,0"
          Panel.ZIndex="50">
      <Button x:Name="FixedBackButton"
              Command="{Binding NavigateHomeCommand}"
              ToolTip="返回首页"
              AutomationProperties.Name="返回首页"
              AutomationProperties.HelpText="返回应用首页。"
              Style="{StaticResource PageBackButton}">
        <StackPanel Orientation="Horizontal">
          <controls:AppIcon Data="{StaticResource Icon.Back}"
                            RenderMode="Stroke"
                            Style="{StaticResource PageBackButtonIcon}" />
          <TextBlock Text="返回首页" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer x:Name="LibraryScrollViewer"
                  Grid.Row="1"
                  Visibility="{Binding IsLibrariesContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  VerticalScrollBarVisibility="Auto"
                  ScrollChanged="OnScrollChanged">
      <StackPanel x:Name="LibraryContentHost" Margin="34,0,34,36">
        <Border Visibility="{Binding IsRefreshingLibraries, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,12"
                Padding="12,8"
                CornerRadius="6"
                Background="#B01A2028">
          <TextBlock Text="&#x6B63;&#x5728;&#x5237;&#x65B0;&#x5A92;&#x4F53;&#x5E93;..."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12" />
        </Border>
        <Border Visibility="{Binding IsLibraryRefreshErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,12"
                Padding="12,8"
                CornerRadius="6"
                Background="#B02A171A"
                BorderBrush="#5AFF7777"
                BorderThickness="1">
          <TextBlock Text="{Binding LibraryErrorMessage, Mode=OneWay}"
                     Foreground="#FF9A9A"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="&#x5A92;&#x4F53;&#x5E93;"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="30"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Text="&#x5168;&#x90E8;&#x5A92;&#x4F53;&#x5E93;" Style="{StaticResource SectionTitleStyle}" />
        <controls:PageStateView IsEmpty="{Binding IsLibrariesEmpty, Mode=OneWay}"
                                EmptyIcon="{StaticResource Icon.Empty}"
                                EmptyTitle="&#x5A92;&#x4F53;&#x5E93;&#x6CA1;&#x6709;&#x5185;&#x5BB9;"
                                EmptyMessage="&#x5F53;&#x524D;&#x8D26;&#x53F7;&#x6CA1;&#x6709;&#x53EF;&#x8BBF;&#x95EE;&#x7684;&#x5A92;&#x4F53;&#x5E93;&#x3002;"
                                MinHeight="120" />
        <ItemsControl ItemsSource="{Binding Libraries}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.SelectLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      ToolTip="{Binding Name, Mode=OneWay}"
                      Style="{StaticResource LibraryButtonStyle}">
                <StackPanel>
                  <TextBlock Text="{Binding Name, Mode=OneWay}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Type, Mode=OneWay}"
                             Margin="0,5,0,0"
                             Foreground="#A8B0BA"
                             FontSize="12"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid x:Name="LibraryContentHeader" Margin="0,20,0,14" HorizontalAlignment="Left"
              Width="{Binding ActualWidth, ElementName=LibraryContentHost, Converter={StaticResource LibraryContentWidthConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding SelectedLibraryName, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                     Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding CanChangeQuery}">
            <Button x:Name="SortButton" Click="OnQueryMenuButtonClick" PreviewKeyDown="OnQueryMenuButtonKeyDown"
                    AutomationProperties.AutomationId="LibrarySortMenu" AutomationProperties.Name="{Binding SortAutomationName}"
                    ToolTip="更改排序依据和顺序" Style="{StaticResource LibraryToolbarButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SortSummary}" VerticalAlignment="Center" />
                <controls:AppIcon Data="{StaticResource Icon.ChevronDown}" RenderMode="Stroke" Size="14" Margin="8,0,0,0" />
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource LibraryQueryMenu}" AutomationProperties.Name="媒体库排序">
                  <MenuItem Header="排序依据" Style="{StaticResource LibraryQueryMenuHeading}" />
                  <MenuItem Header="名称" IsCheckable="True" AutomationProperties.AutomationId="LibrarySortTitle"
                            IsChecked="{Binding SortField, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibrarySortField.Title}}" />
                  <MenuItem Header="添加时间" IsCheckable="True" AutomationProperties.AutomationId="LibrarySortDateAdded"
                            IsChecked="{Binding SortField, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibrarySortField.DateAdded}}" />
                  <MenuItem Header="年份" IsCheckable="True" AutomationProperties.AutomationId="LibrarySortYear"
                            IsChecked="{Binding SortField, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibrarySortField.Year}}" />
                  <Separator Style="{StaticResource LibraryQueryMenuSeparator}" />
                  <MenuItem Header="排序顺序" Style="{StaticResource LibraryQueryMenuHeading}" />
                  <MenuItem Header="升序" IsCheckable="True" AutomationProperties.AutomationId="LibrarySortAscending"
                            IsChecked="{Binding SortDirection, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibrarySortDirection.Ascending}}" />
                  <MenuItem Header="降序" IsCheckable="True" AutomationProperties.AutomationId="LibrarySortDescending"
                            IsChecked="{Binding SortDirection, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibrarySortDirection.Descending}}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="FilterButton" Click="OnQueryMenuButtonClick" PreviewKeyDown="OnQueryMenuButtonKeyDown"
                    AutomationProperties.AutomationId="LibraryFilterMenu" AutomationProperties.Name="{Binding FilterAutomationName}"
                    ToolTip="{Binding FilterAutomationName}" Style="{StaticResource LibraryToolbarButton}">
              <StackPanel Orientation="Horizontal">
                <controls:AppIcon Data="{StaticResource Icon.Filter}" RenderMode="Stroke" Size="18" Margin="0,0,7,0" />
                <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center" />
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu Style="{StaticResource LibraryQueryMenu}" AutomationProperties.Name="媒体库筛选">
                  <MenuItem Header="观看状态" Style="{StaticResource LibraryQueryMenuHeading}" />
                  <MenuItem Header="全部" IsCheckable="True" AutomationProperties.AutomationId="LibraryWatchAll"
                            IsChecked="{Binding WatchedFilter, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibraryWatchedFilter.All}}" />
                  <MenuItem Header="未观看" IsCheckable="True" AutomationProperties.AutomationId="LibraryWatchUnwatched"
                            IsChecked="{Binding WatchedFilter, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibraryWatchedFilter.Unwatched}}" />
                  <MenuItem Header="已观看" IsCheckable="True" AutomationProperties.AutomationId="LibraryWatchWatched"
                            IsChecked="{Binding WatchedFilter, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={x:Static library:LibraryWatchedFilter.Watched}}" />
                  <Separator Style="{StaticResource LibraryQueryMenuSeparator}" />
                  <MenuItem Header="收藏" Style="{StaticResource LibraryQueryMenuHeading}" />
                  <MenuItem Header="全部" IsCheckable="True" AutomationProperties.AutomationId="LibraryFavoriteAll"
                            IsChecked="{Binding FavoritesOnly, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={StaticResource AllFavorites}}" />
                  <MenuItem Header="仅收藏" IsCheckable="True" AutomationProperties.AutomationId="LibraryFavoriteOnly"
                            IsChecked="{Binding FavoritesOnly, Mode=TwoWay, Converter={StaticResource QueryOptionConverter}, ConverterParameter={StaticResource OnlyFavorites}}" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Content="重置" Command="{Binding ResetQueryCommand}"
                    Visibility="{Binding HasQueryOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="LibraryResetQuery" AutomationProperties.Name="重置媒体库排序和筛选"
                    ToolTip="恢复名称升序并清除筛选" Style="{StaticResource LibraryToolbarButton}" />
            <Button Command="{Binding RetryCommand}" Width="42" Padding="0"
                    AutomationProperties.AutomationId="LibraryRefreshQuery" AutomationProperties.Name="刷新当前媒体库结果"
                    ToolTip="刷新" Style="{StaticResource LibraryToolbarButton}">
              <controls:AppIcon Data="{StaticResource Icon.Refresh}" RenderMode="Stroke" Size="18" />
            </Button>
          </StackPanel>
        </Grid>

        <controls:PageStateView IsLoading="{Binding IsInitialItemsLoading, Mode=OneWay}"
                                HasError="{Binding IsContentErrorVisible, Mode=OneWay}"
                                ErrorMessage="{Binding ContentErrorMessage, Mode=OneWay}"
                                LoadingMessage="&#x6B63;&#x5728;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x5185;&#x5BB9;..."
                                ErrorTitle="&#x5185;&#x5BB9;&#x52A0;&#x8F7D;&#x5931;&#x8D25;"
                                ErrorHint="&#x8BF7;&#x7A0D;&#x540E;&#x91CD;&#x8BD5;&#xFF0C;&#x6216;&#x5207;&#x6362;&#x5176;&#x4ED6;&#x5A92;&#x4F53;&#x5E93;&#x3002;"
                                ErrorIcon="{StaticResource Icon.Error}"
                                RetryCommand="{Binding RetryCommand}"
                                RetryAutomationName="&#x91CD;&#x8BD5;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x5185;&#x5BB9;"
                                Margin="0,26,0,0"
                                MinHeight="260" />

        <Border Visibility="{Binding IsRefreshingItems, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,20,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="#B01A2028">
          <TextBlock Text="&#x6B63;&#x5728;&#x5237;&#x65B0;&#x5F53;&#x524D;&#x5A92;&#x4F53;&#x5E93;..."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12" />
        </Border>
        <Border Visibility="{Binding IsContentRefreshErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,20,0,0"
                Padding="12,8"
                CornerRadius="6"
                Background="#B02A171A"
                BorderBrush="#5AFF7777"
                BorderThickness="1">
          <TextBlock Text="{Binding ContentErrorMessage, Mode=OneWay}"
                     Foreground="#FF9A9A"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </Border>

        <StackPanel Visibility="{Binding IsItemsContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <controls:PageStateView IsEmpty="{Binding IsItemsEmpty, Mode=OneWay}"
                                  EmptyIcon="{StaticResource Icon.Empty}"
                                  EmptyTitle="{Binding EmptyItemsTitle}"
                                  EmptyMessage="{Binding EmptyItemsMessage}"
                                  MinHeight="180" />
          <ItemsControl x:Name="LibraryPosterGrid" ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding Title, Mode=OneWay}"
                        Style="{StaticResource PosterButtonStyle}">
                  <StackPanel>
                    <Grid Height="242" Background="#20242B">
                      <TextBlock Text="海报"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                      <controls:AuthenticatedImage ImageUrl="{Binding PosterUrl, Mode=OneWay}"
                                                   PlaceholderText="海报"
                                                   Stretch="UniformToFill" />
                      <Border Visibility="{Binding IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,8,8,0"
                              Style="{StaticResource MediaFavoriteBadgeStyle}">
                        <controls:AppIcon Data="{StaticResource Icon.FavoriteFilled}"
                                          RenderMode="Fill"
                                          Foreground="{StaticResource Icon.FavoriteBrush}"
                                          Style="{StaticResource MediaBadgeIcon}" />
                      </Border>
                      <Border Visibility="{Binding IsPlayed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="8,8,0,0"
                              Style="{StaticResource MediaPlayedBadgeStyle}">
                        <StackPanel Orientation="Horizontal">
                          <controls:AppIcon Data="{StaticResource Icon.Watched}"
                                            RenderMode="Fill"
                                            Foreground="{StaticResource Icon.WatchedBrush}"
                                            Margin="0,0,4,0"
                                            Style="{StaticResource MediaBadgeIcon}" />
                          <TextBlock Text="已看"
                                     Foreground="{StaticResource Icon.WatchedBrush}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <StackPanel Margin="10,10,10,12">
                      <TextBlock Text="{Binding Title, Mode=OneWay}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding YearText, Mode=OneWay}"
                                 Visibility="{Binding HasYear, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="12"
                                 Margin="0,4,0,0" />
                      <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                   Visibility="{Binding HasProgress, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource MediaCardProgressBarStyle}" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="{Binding LoadMoreButtonText, Mode=OneWay}"
                  Command="{Binding LoadMoreCommand}"
                  Visibility="{Binding HasMoreItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  HorizontalAlignment="Center"
                  Margin="0,8,0,0"
                  ToolTip="加载更多媒体内容"
                  AutomationProperties.Name="{Binding LoadMoreButtonText, Mode=OneWay}"
                  AutomationProperties.HelpText="请求下一批媒体内容。"
                  Style="{StaticResource RetryButtonStyle}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
