<UserControl x:Class="EmbyPlayer.UI.Pages.ServerConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style x:Key="PrimaryConnectionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#64C85C" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#78D870" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#3F943A" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#4FA949" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#C6F4BE" />
                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#20242B" />
                <Setter Property="BorderBrush" Value="#303640" />
                <Setter Property="Foreground" Value="#7C858F" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer x:Name="ServerConnectionScrollViewer"
                Background="{StaticResource AppBackgroundBrush}"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="{Binding ViewportHeight, ElementName=ServerConnectionScrollViewer}">
    <Border x:Name="ConnectionCard"
            MaxWidth="560"
            Margin="24"
            Padding="38"
            CornerRadius="8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#252B34"
            BorderThickness="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="连接服务器"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="34"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="输入 Emby Server 地址，连接成功后将进入登录页面。"
                   Margin="0,14,0,30"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="15"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <TextBlock Text="服务器地址"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14"
                   Margin="0,0,0,8" />
        <TextBox x:Name="ServerUrlInput"
                 Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsInputEnabled}"
                 Height="42"
                 Padding="12,0"
                 VerticalContentAlignment="Center"
                 Background="#101318"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 CaretBrush="{StaticResource TextPrimaryBrush}"
                 AutomationProperties.Name="服务器地址">
          <TextBox.Style>
            <Style TargetType="TextBox">
              <Setter Property="BorderBrush" Value="#303640" />
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="#6C8D70" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.55" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <TextBlock Text="例如 192.168.1.100:8096 或 https://media.example.com"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Margin="0,18,0,0"
                   Foreground="#FF6B6B"
                   FontSize="14"
                   TextWrapping="Wrap" />

        <ProgressBar Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,18,0,0"
                     Foreground="{StaticResource AccentBrush}"
                     Background="#101318" />

        <Button x:Name="ConnectButton"
                Content="{Binding ConnectButtonText}"
                Command="{Binding ConnectCommand}"
                IsDefault="True"
                AutomationProperties.Name="连接服务器"
                Height="42"
                Margin="0,26,0,0"
                Style="{StaticResource PrimaryConnectionButtonStyle}" />

        <StackPanel x:Name="RecentServersSection" Margin="0,28,0,0">
          <TextBlock Text="最近服务器" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}" />
          <TextBlock Text="选择地址后点击“连接”。" Margin="0,6,0,12" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <TextBlock Text="正在读取最近服务器..." Margin="0,0,0,8"
                     Visibility="{Binding IsLoadingRecentServers, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="暂无最近连接的服务器" Margin="0,0,0,4"
                     Visibility="{Binding IsRecentServersEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Foreground="{StaticResource TextSecondaryBrush}" />
          <ItemsControl x:Name="RecentServersList" ItemsSource="{Binding RecentServerBases}"
                        AutomationProperties.Name="最近服务器列表">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button Command="{Binding DataContext.SelectRecentServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Height="42" MinWidth="0"
                          Style="{StaticResource MediaSurfaceCardButtonStyle}"
                          ToolTip="{Binding}"
                          AutomationProperties.AutomationId="RecentServer.Select"
                          AutomationProperties.Name="{Binding StringFormat=选择服务器：{0}}"
                          AutomationProperties.HelpText="填入此地址，点击连接按钮后才会连接。">
                    <TextBlock Text="{Binding}" Margin="12,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                  </Button>
                  <Button Grid.Column="1" Content="移除" Margin="8,0,0,0" Padding="12,0" Height="42"
                          Command="{Binding DataContext.RemoveRecentServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" Style="{StaticResource AppSecondaryButtonStyle}"
                          ToolTip="{Binding StringFormat=从最近服务器移除：{0}}"
                          AutomationProperties.AutomationId="RecentServer.Remove"
                          AutomationProperties.Name="{Binding StringFormat=移除服务器：{0}}"
                          AutomationProperties.HelpText="只从最近服务器中移除此地址，不改变当前输入。" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="正在移除..." Margin="0,4,0,0"
                     Visibility="{Binding IsRemovingRecentServer, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding RecentServersErrorMessage}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Visibility="{Binding HasRecentServersError, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Foreground="#FF6B6B" AutomationProperties.LiveSetting="Polite" />
          <Button Content="重新加载最近服务器" Command="{Binding RetryRecentServersCommand}"
                  Visibility="{Binding IsRecentServersLoadErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  HorizontalAlignment="Left" Margin="0,10,0,0"
                  Style="{StaticResource AppSecondaryButtonStyle}"
                  AutomationProperties.Name="重试加载最近服务器" />
        </StackPanel>
      </StackPanel>
    </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
