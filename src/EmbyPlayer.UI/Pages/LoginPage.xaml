<UserControl x:Class="EmbyPlayer.UI.Pages.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Border Width="560"
            Padding="38"
            CornerRadius="8"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#252B34"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="登录"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="34"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="使用 Emby 用户名和密码登录当前服务器。"
                   Margin="0,14,0,26"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="15"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <TextBlock Text="当前服务器"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14"
                   Margin="0,0,0,8" />
        <Border Height="40"
                Padding="12,0"
                Background="#101318"
                BorderBrush="#303640"
                BorderThickness="1">
          <TextBlock Text="{Binding ServerBase}"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
        </Border>

        <TextBlock Text="用户名"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14"
                   Margin="0,18,0,8" />
        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsInputEnabled}"
                 Height="42"
                 Padding="12,0"
                 VerticalContentAlignment="Center"
                 Background="#101318"
                 BorderBrush="#303640"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 CaretBrush="{StaticResource TextPrimaryBrush}" />

        <TextBlock Text="密码"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="14"
                   Margin="0,18,0,8" />
        <PasswordBox x:Name="PasswordInput"
                     IsEnabled="{Binding IsInputEnabled}"
                     Height="42"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     Background="#101318"
                     BorderBrush="#303640"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     PasswordChanged="OnPasswordChanged" />

        <TextBlock Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Margin="0,18,0,0"
                   Foreground="#FF6B6B"
                   FontSize="14"
                   TextWrapping="Wrap" />

        <ProgressBar Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,18,0,0"
                     Foreground="{StaticResource AccentBrush}"
                     Background="#101318" />

        <Button Content="{Binding LoginButtonText}"
                Command="{Binding LoginCommand}"
                Height="42"
                Margin="0,26,0,0"
                IsDefault="True"
                Style="{StaticResource AppPrimaryButtonStyle}"
                ToolTip="登录当前 Emby 服务器"
                AutomationProperties.Name="登录" />
        <Button Content="{Binding SwitchServerButtonText}"
                Command="{Binding SwitchServerCommand}"
                Height="42"
                Margin="0,10,0,0"
                Style="{StaticResource AppSecondaryButtonStyle}"
                ToolTip="清除当前登录状态并连接其他服务器"
                AutomationProperties.Name="切换服务器"
                AutomationProperties.HelpText="清除当前账户登录状态和服务器地址，并返回服务器连接页面。" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
