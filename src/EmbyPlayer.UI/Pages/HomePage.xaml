                <KeyBinding Key="Enter"
                            Command="{Binding SubmitSearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <Button x:Name="HomeWatchLaterButton" Command="{Binding OpenWatchLaterCommand}"
                    Margin="10,0,0,0" ToolTip="稍后观看 · 保存在本机的待看作品"
