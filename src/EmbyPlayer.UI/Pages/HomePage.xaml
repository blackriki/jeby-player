                    Style="{StaticResource HomeIconButtonStyle}">
              <controls:AppIcon Data="{StaticResource Icon.WatchLater}"
                                Style="{StaticResource SolidActionIcon}" />
            </Button>
            <Button x:Name="HomeFavoritesButton" Command="{Binding OpenFavoritesCommand}"
                    Margin="10,0,0,0"
                    ToolTip="查看已收藏的媒体"
                    AutomationProperties.Name="我的收藏"
                    AutomationProperties.HelpText="打开已收藏电影、电视剧和视频列表。"
                    Style="{StaticResource HomeIconButtonStyle}">
              <controls:AppIcon Data="{StaticResource Icon.FavoriteFilled}"
                                Style="{StaticResource SolidActionIcon}" />
            </Button>
            <Button ToolTip="打开设置"
                    AutomationProperties.Name="设置"
                    AutomationProperties.HelpText="打开账号和播放器偏好设置。"
                    Command="{Binding OpenSettingsCommand}"
                    Margin="10,0,0,0"
                    Style="{StaticResource HomeIconButtonStyle}">
              <controls:AppIcon Data="{StaticResource Icon.Settings}"
                                Style="{StaticResource SolidActionIcon}" />
            </Button>
            <Button x:Name="HomeQueueButton" Content="{Binding PendingQueueText}"
                    Visibility="{Binding HasPendingQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Command="{Binding OpenPlaybackQueueCommand}" Margin="10,0,0,0"
                    AutomationProperties.Name="播放队列" ToolTip="查看和调整本次会话的待播顺序"
                    Style="{StaticResource HomeTopButtonStyle}" />
          </WrapPanel>
        </Grid>

        <TextBlock Text="{Binding PlaybackErrorMessage, Mode=OneWay}"
                   Visibility="{Binding IsPlaybackErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Foreground="#F3A6A6"
                   FontSize="13"
                   Margin="0,10,0,-12"
                   AutomationProperties.LiveSetting="Assertive" />

        <Grid x:Name="HeroCarouselRoot"
              Visibility="{Binding HasHeroCard, Converter={StaticResource BooleanToVisibilityConverter}}"
              Margin="0,24,0,22"
              MouseEnter="OnHeroPointerEntered"
              MouseLeave="OnHeroPointerExited"
              IsKeyboardFocusWithinChanged="OnHeroKeyboardFocusWithinChanged"
              PreviewMouseDown="OnHeroPreviewMouseDown"
              PreviewKeyDown="OnHeroPreviewKeyDown">
          <Button Command="{Binding OpenMediaCommand}"
                  CommandParameter="{Binding HeroCard, Mode=OneWay}"
                  AutomationProperties.Name="{Binding HeroCard.Title, Mode=OneWay, StringFormat=今日推荐：{0}}"
                  AutomationProperties.HelpText="打开当前推荐媒体的详情页。"
                  Style="{StaticResource HeroButtonStyle}">
            <Grid x:Name="HeroVisual" Height="310">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" />
                <ColumnDefinition Width="58*" />
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" Background="#101722" />
              <controls:AuthenticatedImage Grid.ColumnSpan="2"
                                           ImageUrl="{Binding HeroCard.HeroImageUrl, Mode=OneWay}"
                                           PlaceholderText="推荐图片"
                                           Stretch="UniformToFill"
                                           Opacity="0.92" />
              <Border Grid.Column="1"
                      Visibility="{Binding HeroCard.IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,14,14,0"
                      Style="{StaticResource MediaFavoriteBadgeStyle}">
                <controls:AppIcon Data="{StaticResource Icon.FavoriteFilled}"
