<UserControl x:Class="EmbyPlayer.UI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:EmbyPlayer.Core.Home;assembly=EmbyPlayer.Core"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="HomePageBackgroundBrush" Color="#080C12" />
    <SolidColorBrush x:Key="HomeSurfaceBrush" Color="#101721" />
    <SolidColorBrush x:Key="HomeCardSurfaceBrush" Color="#151D27" />
    <SolidColorBrush x:Key="HomeCardHoverBrush" Color="#1D2834" />
    <SolidColorBrush x:Key="HomeBorderBrush" Color="#324252" />
    <SolidColorBrush x:Key="HomeBorderHoverBrush" Color="#465A6D" />
    <SolidColorBrush x:Key="HomePrimaryTextBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="HomeSecondaryTextBrush" Color="#A6B1BE" />
    <SolidColorBrush x:Key="HomeMutedTextBrush" Color="#737F8D" />
    <SolidColorBrush x:Key="HomeFocusBrush" Color="#78D36F" />

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource HomePrimaryTextBrush}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="RowArrowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaRowArrowButtonStyle}" />

    <Style x:Key="ViewAllButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource HomeSecondaryTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ViewAllLabel" Text="查看全部" VerticalAlignment="Center" />
                <controls:AppIcon Data="{StaticResource Icon.ChevronRight}"
                                  RenderMode="Stroke" Size="13" Margin="4,0,0,0" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HomeFocusBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{StaticResource HomeFocusBrush}" />
                <Setter TargetName="ViewAllLabel" Property="TextDecorations" Value="Underline" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.65" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="HomePosterCardTemplate">
      <Grid x:Name="PosterCardRoot"
            Width="160"
            Margin="0,0,16,0"
            KeyboardNavigation.TabNavigation="Local">
        <Button Command="{Binding DataContext.OpenMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding Title, Mode=OneWay, StringFormat=打开详情：{0}}"
                AutomationProperties.Name="{Binding Title, Mode=OneWay, StringFormat=打开详情：{0}}"
                Width="Auto"
                Margin="0"
                Style="{DynamicResource CardButtonStyle}">
          <StackPanel>
            <Grid Height="240" Background="#111821">
              <TextBlock Text="海报"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              <controls:AuthenticatedImage ImageUrl="{Binding PosterUrl, Mode=OneWay}"
                                           PlaceholderText="海报"
                                           Stretch="UniformToFill">
                <controls:AuthenticatedImage.Style>
                  <Style TargetType="{x:Type controls:AuthenticatedImage}">
                    <Setter Property="Opacity" Value="0.94" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, ElementName=PosterCardRoot}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </controls:AuthenticatedImage.Style>
              </controls:AuthenticatedImage>
              <Border Height="1"
                      Background="#26313D"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False" />
              <Border Background="#52000000"
                      IsHitTestVisible="False">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMouseOver, ElementName=PosterCardRoot}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <DataTrigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="0"
                                               To="1"
                                               Duration="0:0:0.14" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="1"
                                               To="0"
                                               Duration="0:0:0.14" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PosterCardRoot}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsPreparingPlayback}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
              </Border>
              <Border Visibility="{Binding IsFavorite, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,8,8,0"
                      Style="{StaticResource MediaFavoriteBadgeStyle}">
                <controls:AppIcon Data="{StaticResource Icon.FavoriteFilled}"
                                  RenderMode="Fill"
                                  Size="13"
                                  Foreground="{StaticResource Icon.FavoriteBrush}" />
              </Border>
              <Border Visibility="{Binding IsPlayed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="8,8,0,0"
                      Style="{StaticResource MediaPlayedBadgeStyle}">
                <StackPanel Orientation="Horizontal">
                  <controls:AppIcon Data="{StaticResource Icon.Watched}"
                                    RenderMode="Fill"
                                    Size="13"
                                    Foreground="{StaticResource Icon.WatchedBrush}"
                                    Margin="0,0,5,0" />
                  <TextBlock Text="已看"
                             Foreground="{StaticResource Icon.WatchedBrush}"
                             FontSize="11"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Margin="10,9,10,12">
              <TextBlock Text="{Binding Title}"
                         Foreground="{StaticResource HomePrimaryTextBrush}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding YearText}"
                         Visibility="{Binding HasYear, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Foreground="{StaticResource HomeSecondaryTextBrush}"
                         FontSize="12"
                         Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
        </Button>
        <Button Command="{Binding DataContext.PlayMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Visibility="{Binding IsPlayableMedia, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,96,0,0"
                ToolTip="{Binding Title, Mode=OneWay, StringFormat=从头播放：{0}}"
                ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="{Binding Title, Mode=OneWay, StringFormat=从头播放：{0}}"
                AutomationProperties.HelpText="从头开始播放此媒体。">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource CardOverlayPlayButton}">
              <Setter Property="Opacity" Value="0" />
              <Setter Property="IsHitTestVisible" Value="False" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=PosterCardRoot}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="IsHitTestVisible" Value="True" />
                  <DataTrigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.14" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.EnterActions>
                  <DataTrigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="1"
                                         To="0"
                                         Duration="0:0:0.14" />
                      </Storyboard>
                    </BeginStoryboard>
                  </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PosterCardRoot}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreparingPlayback}" Value="True">
                  <Setter Property="Opacity" Value="1" />
                  <Setter Property="IsHitTestVisible" Value="False" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Border Visibility="{Binding IsPreparingPlayback, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#E6101721"
                BorderBrush="#32FFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="9,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,154,0,0"
                Panel.ZIndex="21"
                IsHitTestVisible="False">
          <TextBlock Text="正在准备播放..."
                     Foreground="#F4F7FB"
                     FontSize="11"
                     AutomationProperties.LiveSetting="Polite" />
        </Border>
      </Grid>
    </DataTemplate>

    <Style x:Key="HomePosterItemsControlStyle" TargetType="ItemsControl">
      <Setter Property="Margin" Value="0,0,24,0" />
      <Setter Property="ItemTemplate" Value="{StaticResource HomePosterCardTemplate}" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="HomeMediaSectionTemplate">
      <StackPanel Margin="0,24,0,0">
        <Grid Margin="0,0,0,14">
          <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" />
          <Button Command="{Binding DataContext.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding Id}"
                  AutomationProperties.AutomationId="{Binding Id, StringFormat=Home.ViewAll.{0}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=查看全部{0}}"
                  ToolTip="{Binding Title, StringFormat=查看全部{0}}"
                  Style="{StaticResource ViewAllButtonStyle}" />
        </Grid>
        <StackPanel Visibility="{Binding IsLoadFailed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">
          <TextBlock Text="暂时无法加载此分类"
                     Foreground="{StaticResource HomeSecondaryTextBrush}"
                     FontSize="14"
                     VerticalAlignment="Center" />
          <Button Command="{Binding DataContext.LoadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Content="重新加载"
                  Margin="16,0,0,0"
                  Style="{StaticResource AppPrimaryButtonStyle}" />
        </StackPanel>
        <TextBlock Text="{Binding Title, StringFormat=暂无{0}}"
                   Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Foreground="{StaticResource HomeSecondaryTextBrush}"
                   FontSize="14"
                   Margin="0,0,0,4" />
        <Grid Tag="HomeMediaSectionRow"
              Background="Transparent"
              MouseEnter="OnCategoryRowMouseEnter"
              MouseLeave="OnCategoryRowMouseLeave"
              IsKeyboardFocusWithinChanged="OnHorizontalRowKeyboardFocusWithinChanged">
          <ScrollViewer x:Name="CategoryScrollViewer"
                        Visibility="{Binding HasItems, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalScrollBarVisibility="Hidden"
                         VerticalScrollBarVisibility="Disabled"
                         Loaded="OnHorizontalRowLoaded"
                         PreviewMouseWheel="OnHorizontalRowPreviewMouseWheel"
                        PreviewKeyDown="OnHorizontalRowPreviewKeyDown"
                        ScrollChanged="OnHorizontalRowScrollChanged"
                        SizeChanged="OnHorizontalRowSizeChanged">
            <ItemsControl ItemsSource="{Binding Items}"
                          Style="{StaticResource HomePosterItemsControlStyle}" />
          </ScrollViewer>
          <Button Tag="{Binding ElementName=CategoryScrollViewer}"
                  ToolTip="{Binding Title, StringFormat=向左滚动{0}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=向左滚动{0}}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  Click="OnCategoryLeftClick"
                  Style="{StaticResource RowArrowButtonStyle}">
            <controls:AppIcon Data="{StaticResource Icon.ChevronLeft}" RenderMode="Stroke" Size="20" />
          </Button>
          <Button Tag="{Binding ElementName=CategoryScrollViewer}"
                  ToolTip="{Binding Title, StringFormat=向右滚动{0}}"
                  AutomationProperties.Name="{Binding Title, StringFormat=向右滚动{0}}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Visibility="Collapsed"
                  Click="OnCategoryRightClick"
                  Style="{StaticResource RowArrowButtonStyle}">
            <controls:AppIcon Data="{StaticResource Icon.ChevronRight}" RenderMode="Stroke" Size="20" />
          </Button>
        </Grid>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="CardButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaSurfaceCardButtonStyle}">
      <Setter Property="Width" Value="160" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>

    <Style x:Key="ContinueCardButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource CardButtonStyle}">
      <Setter Property="Width" Value="260" />
      <Setter Property="Margin" Value="0,0,18,0" />
    </Style>

    <Style x:Key="HeroButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{StaticResource HomeSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <controls:RoundedClipBorder x:Name="HeroChrome"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="16">
              <ContentPresenter />
            </controls:RoundedClipBorder>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HeroChrome" Property="BorderBrush" Value="#32FFFFFF" />
                <Setter TargetName="HeroChrome" Property="Background" Value="#111923" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="HeroChrome" Property="BorderBrush" Value="#78D36F" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="176" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="LibraryRoot">
              <Border x:Name="LibraryChrome"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="10">
                <Border.Background>
                  <SolidColorBrush x:Name="LibraryBackgroundBrush" Color="#151D27" />
                </Border.Background>
                <Border.BorderBrush>
                  <SolidColorBrush x:Name="LibraryBorderBrush" Color="#00000000" />
                </Border.BorderBrush>
                <ContentPresenter HorizontalAlignment="Stretch" />
              </Border>
              <Border x:Name="LibraryFocusRing"
                      BorderBrush="Transparent"
                      BorderThickness="2"
                      CornerRadius="10"
                      IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="LibraryBackgroundBrush"
                                      Storyboard.TargetProperty="Color"
                                      To="#1D2834"
                                      Duration="0:0:0.14" />
                      <ColorAnimation Storyboard.TargetName="LibraryBorderBrush"
                                      Storyboard.TargetProperty="Color"
                                      To="#38FFFFFF"
                                      Duration="0:0:0.14" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="LibraryBackgroundBrush"
                                      Storyboard.TargetProperty="Color"
                                      To="#151D27"
                                      Duration="0:0:0.14" />
                      <ColorAnimation Storyboard.TargetName="LibraryBorderBrush"
                                      Storyboard.TargetProperty="Color"
                                      To="#00000000"
                                      Duration="0:0:0.14" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="LibraryFocusRing" Property="BorderBrush" Value="#78D36F" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="LibraryRoot" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeroNavigationButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#C0101721" />
      <Setter Property="BorderBrush" Value="#70455362" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F4F7FB" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Opacity" Value="0.18" />
      <Setter Property="Panel.ZIndex" Value="20" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavigationChrome"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="22">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,-3,0,0" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavigationChrome" Property="Background" Value="#F0222C38" />
                <Setter TargetName="NavigationChrome" Property="BorderBrush" Value="#AA78D36F" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="NavigationChrome" Property="Background" Value="#F02B3846" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="NavigationChrome" Property="BorderBrush" Value="#78D36F" />
                <Setter Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeroIndicatorButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="IndicatorChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IndicatorChrome" Property="Background" Value="#332A3542" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LibraryIconStyle" TargetType="Image">
      <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibraryMovie.png" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Type}" Value="电影">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibraryMovie.png" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="电视剧">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibrarySeries.png" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="电视节目">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibrarySeries.png" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="动画">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibraryAnimation.png" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="合集">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibraryBoxSet.png" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Type}" Value="播放列表">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibraryPlaylist.png" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Name}" Value="动画">
          <Setter Property="Source" Value="/EmbyPlayer.UI;component/Assets/HomeIcons/Icon.LibraryAnimation.png" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="HomeTopButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Background" Value="{StaticResource HomeCardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource HomePrimaryTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TopButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TopButtonChrome" Property="Background" Value="#1D2834" />
                <Setter TargetName="TopButtonChrome" Property="BorderBrush" Value="#3A4A5A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TopButtonChrome" Property="Background" Value="#243140" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TopButtonChrome" Property="BorderBrush" Value="#78D36F" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="TopButtonChrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HomeIconButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource HomeTopButtonStyle}">
      <Setter Property="Width" Value="50" />
      <Setter Property="MinWidth" Value="50" />
      <Setter Property="Padding" Value="0" />
    </Style>

  </UserControl.Resources>

  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#070B10" Offset="0" />
        <GradientStop Color="#0B1018" Offset="0.48" />
        <GradientStop Color="#05080C" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <controls:PageStateView IsLoading="{Binding IsInitialLoading, Mode=OneWay}"
                            HasError="{Binding IsErrorVisible, Mode=OneWay}"
                            ErrorMessage="{Binding ErrorMessage, Mode=OneWay}"
                            LoadingMessage="&#x6B63;&#x5728;&#x52A0;&#x8F7D;&#x9996;&#x9875;..."
                            ErrorTitle="&#x9996;&#x9875;&#x52A0;&#x8F7D;&#x5931;&#x8D25;"
                            ErrorHint="&#x8BF7;&#x68C0;&#x67E5;&#x7F51;&#x7EDC;&#x6216;&#x670D;&#x52A1;&#x5668;&#x72B6;&#x6001;&#x540E;&#x91CD;&#x8BD5;&#x3002;"
                            ErrorIcon="{StaticResource Icon.Error}"
                            RetryCommand="{Binding RetryCommand}"
                            RetryToolTip="&#x91CD;&#x65B0;&#x52A0;&#x8F7D;&#x9996;&#x9875;&#x5185;&#x5BB9;"
                            RetryAutomationName="&#x91CD;&#x8BD5;&#x52A0;&#x8F7D;&#x9996;&#x9875;" />

    <ScrollViewer x:Name="HomePageScrollViewer"
                  Visibility="{Binding IsContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
