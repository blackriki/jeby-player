                Margin="0,0,0,12"
                Padding="12,8"
                CornerRadius="6"
                Background="#B01A2028">
          <TextBlock Text="&#x6B63;&#x5728;&#x5237;&#x65B0;&#x9996;&#x9875;&#x5185;&#x5BB9;..."
                     Foreground="{StaticResource TextSecondaryBrush}"
                     FontSize="12" />
        </Border>
        <Border Visibility="{Binding IsRefreshErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,12"
                Padding="12,8"
                CornerRadius="6"
                Background="#B02A171A"
                BorderBrush="#5AFF7777"
                BorderThickness="1">
          <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                     Foreground="#FF9A9A"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </Border>
        <Grid x:Name="HomeHeaderGrid">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="HomeWelcomeTextBlock"
                     Text="{Binding WelcomeText, Mode=OneWay}"
                     Foreground="{StaticResource HomePrimaryTextBrush}"
                     FontSize="28"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <WrapPanel x:Name="HomeHeaderActionsPanel"
                     Grid.Column="1"
                     MaxWidth="660"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center">
            <TextBlock Text="{Binding SearchPlaceholderMessage, Mode=OneWay}"
                       Visibility="{Binding IsSearchPlaceholderMessageVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
            <TextBox x:Name="HomeSearchTextBox"
                     MinWidth="180"
                     Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource AppSearchTextBoxStyle}"
                     ToolTip="输入关键词后按回车搜索"
                     AutomationProperties.Name="搜索关键词"
                     AutomationProperties.HelpText="输入电影、电视剧、单集或合集名称进行搜索。">
