                      <Grid Grid.Row="1" Margin="13,11,13,12">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding NumberText, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}"
                                     FontSize="12"
                                     FontWeight="SemiBold" />
                          <TextBlock Text="·"
                                     Margin="10,0"
                                     Foreground="{StaticResource DetailMutedTextBrush}"
                                     FontSize="12" />
                          <TextBlock Text="{Binding DurationText, Mode=OneWay}"
                                     Foreground="{StaticResource DetailMutedTextBrush}"
                                     FontSize="12"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding Title, Mode=OneWay}"
                                   Margin="0,7,0,0"
                                   MaxHeight="44"
                                   Foreground="{StaticResource DetailPrimaryTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2"
                                   Text="{Binding OverviewText, Mode=OneWay}"
                                   Margin="0,8,0,0"
                                   MaxHeight="60"
                                   Foreground="{StaticResource DetailSecondaryTextBrush}"
                                   FontSize="13"
                                   LineHeight="20"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>

                      <Border Grid.RowSpan="2"
                              Background="#101B3328"
                              BorderBrush="#B052B54B"
                              BorderThickness="2"
                              CornerRadius="10"
                              IsHitTestVisible="False"
                              Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="EpisodeCardPreviousButton"
                      CommandParameter="{Binding ElementName=EpisodeCardListBox}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Margin="4,0,0,0"
                      ToolTip="向左浏览分集卡片"
                      AutomationProperties.Name="向左浏览分集卡片"
                      Visibility="Collapsed"
                      Click="OnHorizontalRowLeftClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronLeft}" RenderMode="Stroke" Size="19" />
              </Button>
              <Button x:Name="EpisodeCardNextButton"
                      CommandParameter="{Binding ElementName=EpisodeCardListBox}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,4,0"
                      ToolTip="向右浏览分集卡片"
                      AutomationProperties.Name="向右浏览分集卡片"
                      Visibility="Collapsed"
                      Click="OnHorizontalRowRightClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronRight}" RenderMode="Stroke" Size="19" />
              </Button>
            </Grid>
          </Grid>

          </StackPanel>

          <StackPanel x:Name="PeopleSection"
                      Visibility="{Binding IsPeopleSectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="0,44,0,0">
            <TextBlock Text="演职人员"
                       Foreground="{StaticResource DetailPrimaryTextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <Grid x:Name="PeopleRow"
                  Margin="0,20,0,0"
                  Background="Transparent"
                  MouseEnter="OnHorizontalRowMouseEnter"
                  MouseLeave="OnHorizontalRowMouseLeave"
                  IsKeyboardFocusWithinChanged="OnHorizontalRowKeyboardFocusWithinChanged">
              <ScrollViewer x:Name="PeopleScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            PanningMode="HorizontalOnly"
                            Focusable="True"
                            Loaded="OnHorizontalRowLoaded"
                            PreviewMouseWheel="OnHorizontalRowPreviewMouseWheel"
                            PreviewKeyDown="OnHorizontalRowPreviewKeyDown"
                            ScrollChanged="OnHorizontalRowScrollChanged"
                            SizeChanged="OnHorizontalRowSizeChanged"
                            AutomationProperties.Name="演职人员横向列表">
                <ItemsControl ItemsSource="{Binding People, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="148"
                                                   Height="250"
                                                   Margin="0,0,16,8"
                                                   ToolTip="{Binding Name, Mode=OneWay, StringFormat=演职人员：{0}}"
                                                   AutomationProperties.Name="{Binding Name, Mode=OneWay, StringFormat=演职人员：{0}}"
                                                   AutomationProperties.HelpText="{Binding Role, Mode=OneWay}"
                                                   Command="{Binding DataContext.OpenPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Style="{StaticResource MediaSurfaceCardButtonStyle}">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="196" />
                            <RowDefinition Height="*" />
                          </Grid.RowDefinitions>
                          <Grid Background="#141A23">
                            <controls:AuthenticatedImage ImageUrl="{Binding ImageUrl, Mode=OneWay}"
                                                         PlaceholderText="暂无人物图片"
                                                         Stretch="UniformToFill" />
                          </Grid>
                          <StackPanel Grid.Row="1" Margin="10,9,10,8">
                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                       Foreground="{StaticResource DetailPrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Role, Mode=OneWay}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource DetailSecondaryTextBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="PeoplePreviousButton"
                      CommandParameter="{Binding ElementName=PeopleScrollViewer}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="向左浏览演职人员"
                      AutomationProperties.Name="向左浏览演职人员"
                      Click="OnHorizontalRowLeftClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronLeft}" RenderMode="Stroke" Size="20" />
              </Button>
              <Button x:Name="PeopleNextButton"
                      CommandParameter="{Binding ElementName=PeopleScrollViewer}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="向右浏览演职人员"
                      AutomationProperties.Name="向右浏览演职人员"
                      Click="OnHorizontalRowRightClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronRight}" RenderMode="Stroke" Size="20" />
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="ArtworkSection"
                      Visibility="{Binding IsArtworkSectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="0,44,0,0">
            <TextBlock Text="艺术图"
                       Foreground="{StaticResource DetailPrimaryTextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <Grid x:Name="ArtworkRow"
                  Margin="0,20,0,0"
                  Background="Transparent"
                  MouseEnter="OnHorizontalRowMouseEnter"
                  MouseLeave="OnHorizontalRowMouseLeave"
                  IsKeyboardFocusWithinChanged="OnHorizontalRowKeyboardFocusWithinChanged">
              <ScrollViewer x:Name="ArtworkScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            PanningMode="HorizontalOnly"
                            Focusable="True"
                            Loaded="OnHorizontalRowLoaded"
                            PreviewMouseWheel="OnHorizontalRowPreviewMouseWheel"
                            PreviewKeyDown="OnHorizontalRowPreviewKeyDown"
                            ScrollChanged="OnHorizontalRowScrollChanged"
                            SizeChanged="OnHorizontalRowSizeChanged"
                            AutomationProperties.Name="艺术图横向列表">
                <ItemsControl ItemsSource="{Binding ArtworkUrls, Mode=OneWay}"
                              AlternationCount="12">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <controls:RoundedClipBorder Width="324"
                                                   Height="182"
                                                   Margin="0,0,18,8"
                                                   ToolTip="艺术图缩略图"
                                                   AutomationProperties.Name="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), StringFormat=艺术图 {0}}"
                                                   AutomationProperties.HelpText="仅展示艺术图缩略图，不打开预览。"
                                                   Style="{StaticResource InformationalCardStyle}">
                        <controls:AuthenticatedImage ImageUrl="{Binding Mode=OneWay}"
                                                     PlaceholderText="暂无艺术图"
                                                     Stretch="UniformToFill" />
                      </controls:RoundedClipBorder>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="ArtworkPreviousButton"
                      CommandParameter="{Binding ElementName=ArtworkScrollViewer}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="向左浏览艺术图"
                      AutomationProperties.Name="向左浏览艺术图"
                      Click="OnHorizontalRowLeftClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronLeft}" RenderMode="Stroke" Size="20" />
              </Button>
              <Button x:Name="ArtworkNextButton"
                      CommandParameter="{Binding ElementName=ArtworkScrollViewer}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="向右浏览艺术图"
                      AutomationProperties.Name="向右浏览艺术图"
                      Click="OnHorizontalRowRightClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronRight}" RenderMode="Stroke" Size="20" />
              </Button>
            </Grid>
          </StackPanel>

          <StackPanel x:Name="SimilarSection"
                      Visibility="{Binding IsSimilarSectionVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Margin="0,44,0,0">
            <TextBlock Text="类似作品"
                       Foreground="{StaticResource DetailPrimaryTextBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <controls:PageStateView IsLoading="{Binding IsSimilarInitialLoading, Mode=OneWay}"
                                    HasError="{Binding IsSimilarErrorVisible, Mode=OneWay}"
                                    ErrorMessage="{Binding SimilarErrorMessage, Mode=OneWay}"
                                    LoadingMessage="正在加载类似作品..."
                                    ErrorTitle="类似作品加载失败"
                                    ErrorHint="其他详情内容仍可正常使用。"
                                    ErrorIcon="{StaticResource Icon.Error}"
                                    RetryCommand="{Binding RetrySimilarCommand}"
                                    RetryAutomationName="重试加载类似作品"
                                    Margin="0,18,0,0"
                                    MinHeight="140" />

            <Grid x:Name="SimilarRow"
                  Visibility="{Binding IsSimilarItemsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Margin="0,20,0,0"
                   Background="Transparent"
                   MouseEnter="OnHorizontalRowMouseEnter"
                   MouseLeave="OnHorizontalRowMouseLeave"
                   IsKeyboardFocusWithinChanged="OnHorizontalRowKeyboardFocusWithinChanged">
              <ScrollViewer x:Name="SimilarScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            PanningMode="HorizontalOnly"
                            Focusable="True"
                            Loaded="OnHorizontalRowLoaded"
                            PreviewMouseWheel="OnHorizontalRowPreviewMouseWheel"
                            PreviewKeyDown="OnHorizontalRowPreviewKeyDown"
                            ScrollChanged="OnHorizontalRowScrollChanged"
                            SizeChanged="OnHorizontalRowSizeChanged"
                            AutomationProperties.Name="类似作品横向列表">
                <ItemsControl ItemsSource="{Binding SimilarItems, Mode=OneWay}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding DataContext.OpenSimilarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              ToolTip="{Binding Title, Mode=OneWay, StringFormat=打开详情：{0}}"
                              AutomationProperties.Name="{Binding AutomationName, Mode=OneWay}"
                              Style="{StaticResource SimilarCardButtonStyle}">
                        <StackPanel>
                          <Grid Height="240" Background="#111821">
                            <TextBlock Text="海报"
                                       Foreground="{StaticResource DetailMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <controls:AuthenticatedImage ImageUrl="{Binding PosterUrl, Mode=OneWay}"
                                                         PlaceholderText="海报"
                                                         Stretch="UniformToFill" />
                            <Border Visibility="{Binding IsPlayed, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Style="{StaticResource MediaPlayedBadgeStyle}">
                              <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Data="{StaticResource Icon.Watched}"
                                                  RenderMode="Fill"
                                                  Size="13"
                                                  Foreground="{StaticResource Icon.WatchedBrush}"
                                                  Margin="0,0,5,0" />
                                <TextBlock Text="已看"
                                           Foreground="{StaticResource Icon.WatchedBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                              </StackPanel>
                            </Border>
                            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                         Visibility="{Binding HasProgress, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         VerticalAlignment="Bottom"
                                         Margin="8"
                                         Style="{StaticResource MediaCardProgressBarStyle}" />
                          </Grid>
                          <StackPanel Margin="10,9,10,12">
                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                       Foreground="{StaticResource DetailPrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding YearText, Mode=OneWay}"
                                       Visibility="{Binding HasYear, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource DetailSecondaryTextBrush}"
                                       FontSize="12" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="SimilarPreviousButton"
                      CommandParameter="{Binding ElementName=SimilarScrollViewer}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="向左浏览类似作品"
                      AutomationProperties.Name="向左浏览类似作品"
                      Click="OnHorizontalRowLeftClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronLeft}" RenderMode="Stroke" Size="20" />
              </Button>
              <Button x:Name="SimilarNextButton"
                      CommandParameter="{Binding ElementName=SimilarScrollViewer}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      ToolTip="向右浏览类似作品"
                      AutomationProperties.Name="向右浏览类似作品"
                      Click="OnHorizontalRowRightClick"
                      Style="{StaticResource EpisodeTrackArrowButtonStyle}">
                <controls:AppIcon Data="{StaticResource Icon.ChevronRight}" RenderMode="Stroke" Size="20" />
              </Button>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border x:Name="FixedBackScrim"
            Visibility="{Binding IsContentVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            Style="{StaticResource FixedPageBackScrim}" />

    <Button x:Name="FixedBackButton"
            Command="{Binding BackCommand}"
            Visibility="{Binding IsContentVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="54,32,0,0"
            ToolTip="返回上一页"
            AutomationProperties.Name="返回"
            AutomationProperties.HelpText="返回上一个页面。"
            Panel.ZIndex="50"
            Style="{StaticResource PageBackButton}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:AppIcon Data="{StaticResource Icon.Back}" Style="{StaticResource PageBackButtonIcon}" />
        <TextBlock Text="返回" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <Border Visibility="{Binding IsRefreshing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            Margin="0,20,28,0"
            Padding="12,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="6"
            Background="#D0182028"
            Panel.ZIndex="60">
      <TextBlock Text="&#x6B63;&#x5728;&#x5237;&#x65B0;&#x8BE6;&#x60C5;..."
                 Foreground="{StaticResource DetailSecondaryTextBrush}"
                 FontSize="12" />
    </Border>
    <Border Visibility="{Binding IsRefreshErrorVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            Margin="0,20,28,0"
            Padding="12,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="6"
            Background="#D02A171A"
            BorderBrush="#5AFF7777"
            BorderThickness="1"
            Panel.ZIndex="60">
      <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                 MaxWidth="420"
                 Foreground="#FF9A9A"
                 FontSize="12"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
