<UserControl x:Class="EmbyPlayer.UI.Pages.MediaDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <SolidColorBrush x:Key="DetailPageBackgroundBrush" Color="#080C12" />
    <SolidColorBrush x:Key="DetailSurfaceBrush" Color="#101721" />
    <SolidColorBrush x:Key="DetailCardSurfaceBrush" Color="#151D27" />
    <SolidColorBrush x:Key="DetailCardHoverBrush" Color="#1D2834" />
    <SolidColorBrush x:Key="DetailBorderBrush" Color="#324252" />
    <SolidColorBrush x:Key="DetailPrimaryTextBrush" Color="#F4F7FB" />
    <SolidColorBrush x:Key="DetailSecondaryTextBrush" Color="#A6B1BE" />
    <SolidColorBrush x:Key="DetailMutedTextBrush" Color="#737F8D" />
    <SolidColorBrush x:Key="DetailErrorSurfaceBrush" Color="#21171A" />
    <SolidColorBrush x:Key="DetailErrorBorderBrush" Color="#59313A" />
    <SolidColorBrush x:Key="DetailErrorTextBrush" Color="#FF8A8A" />
    <SolidColorBrush x:Key="DetailFocusBrush" Color="#78D36F" />
    <SolidColorBrush x:Key="DetailProgressTrackBrush" Color="#303640" />

    <Style x:Key="DetailCompactActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
      <Setter Property="Width" Value="48" />
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="DetailCompactActionIcon" TargetType="controls:AppIcon" BasedOn="{StaticResource SolidActionIcon}">
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="DetailPlayedIcon" TargetType="controls:AppIcon" BasedOn="{StaticResource DetailCompactActionIcon}">
      <Setter Property="Data" Value="{StaticResource Icon.Unwatched}" />
      <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPlayed, Mode=OneWay}" Value="True">
          <Setter Property="Data" Value="{StaticResource Icon.Watched}" />
          <Setter Property="Foreground" Value="{StaticResource Icon.WatchedBrush}" />
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource DetailMutedTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DetailFavoriteIcon" TargetType="controls:AppIcon" BasedOn="{StaticResource DetailCompactActionIcon}">
      <Setter Property="Data" Value="{StaticResource Icon.FavoriteFilled}" />
      <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFavorite, Mode=OneWay}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Icon.FavoriteBrush}" />
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource DetailMutedTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DetailWatchLaterIcon" TargetType="controls:AppIcon" BasedOn="{StaticResource DetailCompactActionIcon}">
      <Setter Property="Data" Value="{StaticResource Icon.WatchLater}" />
      <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSavedForLater, Mode=OneWay}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Icon.WatchLaterBrush}" />
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{StaticResource DetailMutedTextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DetailButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#172231" />
      <Setter Property="BorderBrush" Value="#354455" />
      <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="MinWidth" Value="110" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="23">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#213046" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#52677D" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource DetailFocusBrush}" />
                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Background" Value="#111822" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#253140" />
                <Setter Property="Foreground" Value="#647181" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DetailButtonStyle}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="#63C85C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="MinWidth" Value="132" />
    </Style>

    <Style x:Key="EpisodeTrackArrowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaRowArrowButtonStyle}" />

    <Style x:Key="BackButtonStyle" TargetType="Button" BasedOn="{StaticResource DetailButtonStyle}">
      <Setter Property="MinWidth" Value="86" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Background" Value="#A60B111A" />
      <Setter Property="BorderBrush" Value="#384657" />
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource DetailSecondaryTextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetaSeparatorStyle" TargetType="TextBlock" BasedOn="{StaticResource MetaTextStyle}">
      <Setter Property="Text" Value="·" />
      <Setter Property="Foreground" Value="{StaticResource DetailMutedTextBrush}" />
    </Style>

    <Style x:Key="GenreBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="#1A2534" />
      <Setter Property="BorderBrush" Value="#354657" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

    <Style x:Key="ProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource DetailProgressTrackBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="3"
                    ClipToBounds="True">
              <Grid x:Name="PART_Track">
                <Rectangle x:Name="PART_Indicator"
                           HorizontalAlignment="Left"
                           Fill="{TemplateBinding Foreground}"
                           RadiusX="3"
                           RadiusY="3" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LoadingProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="{StaticResource DetailProgressTrackBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="SeasonCardButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource DetailCardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="MinWidth" Value="116" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="Margin" Value="0,0,12,0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="SeasonChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SeasonChrome" Property="Background" Value="{StaticResource DetailCardHoverBrush}" />
                <Setter TargetName="SeasonChrome" Property="BorderBrush" Value="#4D6175" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SeasonChrome" Property="BorderBrush" Value="{StaticResource DetailFocusBrush}" />
                <Setter TargetName="SeasonChrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, Mode=OneWay}" Value="True">
          <Setter Property="Background" Value="#1B3328" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="EpisodeNumberListBoxItemStyle" TargetType="ListBoxItem">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource DetailSecondaryTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName, Mode=OneWay}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NumberChrome"
                    Background="#1A222D"
                    BorderBrush="#334252"
                    BorderThickness="1"
                    CornerRadius="21">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NumberChrome" Property="Background" Value="{StaticResource DetailCardHoverBrush}" />
                <Setter TargetName="NumberChrome" Property="BorderBrush" Value="#52677D" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NumberChrome" Property="Background" Value="#F2F5F8" />
                <Setter TargetName="NumberChrome" Property="BorderBrush" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#111821" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="NumberChrome" Property="BorderBrush" Value="{StaticResource DetailFocusBrush}" />
                <Setter TargetName="NumberChrome" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EpisodeCardListBoxItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="Width" Value="292" />
      <Setter Property="Height" Value="334" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="EpisodeCardButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaSurfaceCardButtonStyle}">
      <Setter Property="Width" Value="292" />
      <Setter Property="Height" Value="334" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="SimilarCardButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MediaSurfaceCardButtonStyle}">
      <Setter Property="Width" Value="160" />
      <Setter Property="Margin" Value="0,0,16,8" />
      <Setter Property="Foreground" Value="{StaticResource DetailPrimaryTextBrush}" />
    </Style>

    <Style x:Key="InformationalCardStyle" TargetType="controls:RoundedClipBorder">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{StaticResource DetailCardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ClipToBounds" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource DetailCardHoverBrush}" />
          <Setter Property="BorderBrush" Value="#38FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StateCardStyle" TargetType="Border">
      <Setter Property="Padding" Value="22" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource DetailCardSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DetailBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource DetailPageBackgroundBrush}">
    <controls:PageStateView IsLoading="{Binding IsInitialLoading, Mode=OneWay}"
                            HasError="{Binding IsErrorVisible, Mode=OneWay}"
                            ErrorMessage="{Binding ErrorMessage, Mode=OneWay}"
                            LoadingMessage="&#x6B63;&#x5728;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x8BE6;&#x60C5;..."
                            ErrorTitle="&#x8BE6;&#x60C5;&#x52A0;&#x8F7D;&#x5931;&#x8D25;"
                            ErrorHint="&#x8BF7;&#x5728;&#x7F51;&#x7EDC;&#x6062;&#x590D;&#x540E;&#x91CD;&#x65B0;&#x52A0;&#x8F7D;&#x3002;"
                            ErrorIcon="{StaticResource Icon.Error}"
                            RetryCommand="{Binding RetryCommand}"
                            RetryToolTip="&#x91CD;&#x65B0;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x8BE6;&#x60C5;"
                            RetryAutomationName="&#x91CD;&#x8BD5;&#x52A0;&#x8F7D;&#x5A92;&#x4F53;&#x8BE6;&#x60C5;" />

    <Button Command="{Binding BackCommand}"
            Visibility="{Binding IsErrorVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            Margin="0,210,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ToolTip="&#x8FD4;&#x56DE;&#x4E0A;&#x4E00;&#x9875;"
            AutomationProperties.Name="&#x8FD4;&#x56DE;"
            AutomationProperties.HelpText="&#x8FD4;&#x56DE;&#x4E0A;&#x4E00;&#x4E2A;&#x9875;&#x9762;&#x3002;"
            Style="{StaticResource PageBackButton}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:AppIcon Data="{StaticResource Icon.Back}" Style="{StaticResource PageBackButtonIcon}" />
        <TextBlock Text="&#x8FD4;&#x56DE;" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <ScrollViewer x:Name="MediaDetailScrollViewer"
                  Visibility="{Binding IsContentVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  ScrollChanged="OnMediaDetailScrollChanged">
      <Grid MinHeight="720">
        <Grid.RowDefinitions>
          <RowDefinition Height="530" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#070A0F" ClipToBounds="True">
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A111B" Offset="0" />
                <GradientStop Color="#0E1724" Offset="0.55" />
                <GradientStop Color="#080C12" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <controls:AuthenticatedImage ImageUrl="{Binding BackdropUrl, Mode=OneWay}"
                                       PlaceholderText="背景图"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       Opacity="0.96" />

          <controls:AuthenticatedImage x:Name="EpisodeHeroLayer"
                                       ImageUrl="{Binding SelectedEpisodeHeroUrl, Mode=OneWay}"
                                       ShowPlaceholder="False"
                                       Stretch="Uniform"
                                       ImageHorizontalAlignment="Right"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Opacity="0.96"
                                       IsHitTestVisible="False"
                                       Focusable="False" />

          <Rectangle>
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF080C12" Offset="0" />
                <GradientStop Color="#FA080C12" Offset="0.45" />
                <GradientStop Color="#C8080C12" Offset="0.58" />
                <GradientStop Color="#70080C12" Offset="0.74" />
                <GradientStop Color="#18080C12" Offset="0.90" />
                <GradientStop Color="#00080C12" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

          <Rectangle VerticalAlignment="Bottom" Height="150">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00080C12" Offset="0" />
                <GradientStop Color="#D9080C12" Offset="0.76" />
                <GradientStop Color="#FF080C12" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>

        </Grid>

        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Margin="54,130,54,0"
              MaxWidth="1380"
              HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="212" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0"
                      MaxWidth="760"
                      VerticalAlignment="Top">
            <TextBlock Foreground="{StaticResource AccentBrush}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding TypeText, Mode=OneWay, StringFormat={}{0}详情}" />

            <TextBlock Text="{Binding Title, Mode=OneWay}"
                       Margin="0,16,0,0"
                       Foreground="{StaticResource DetailPrimaryTextBrush}"
                       FontSize="52"
                       FontWeight="Bold"
                       LineHeight="58"
                       TextWrapping="Wrap" />

            <WrapPanel Margin="0,20,0,0">
              <TextBlock Text="{Binding YearText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
              <TextBlock Style="{StaticResource MetaSeparatorStyle}" />
              <TextBlock Text="{Binding TypeText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
              <TextBlock Style="{StaticResource MetaSeparatorStyle}" />
              <TextBlock Text="{Binding DurationText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
              <TextBlock Style="{StaticResource MetaSeparatorStyle}" />
              <TextBlock Text="{Binding RatingText, Mode=OneWay}" Style="{StaticResource MetaTextStyle}" />
            </WrapPanel>

            <ItemsControl ItemsSource="{Binding Detail.Genres, Mode=OneWay}" Margin="0,20,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource GenreBadgeStyle}">
                    <TextBlock Text="{Binding Mode=OneWay}"
                               Foreground="{StaticResource DetailPrimaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding OverviewText, Mode=OneWay}"
                       Margin="0,24,0,0"
                       Foreground="#DDE4EC"
                       FontSize="16"
                       LineHeight="25"
                       MaxHeight="76"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding IsStandardProgressVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,30,0,0"
                        MaxWidth="860">
              <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                         Foreground="{StaticResource DetailSecondaryTextBrush}"
                         FontSize="13"
                         FontWeight="SemiBold" />
              <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                           Maximum="100"
                           Margin="0,8,0,0"
                           Style="{StaticResource ProgressBarStyle}" />
            </StackPanel>

            <StackPanel x:Name="DetailMovieActions" Orientation="Horizontal" Margin="0,28,0,0"
                       Visibility="{Binding IsStandardPlaybackPanelVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Button Command="{Binding PlayCommand}"
                      ToolTip="播放当前媒体"
                      AutomationProperties.Name="播放"
                      AutomationProperties.HelpText="从默认位置开始播放当前媒体。"
                      ToolTipService.ShowOnDisabled="True">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsContinuePlaybackVisible, Mode=OneWay}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <controls:AppIcon Data="{StaticResource Icon.Play}" Style="{StaticResource PrimaryActionButtonIcon}" />
                  <TextBlock Text="播放" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ContinuePlayCommand}"
                      Visibility="{Binding IsContinuePlaybackVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                      ToolTip="从上次进度继续播放"
                      AutomationProperties.Name="继续播放"
                      AutomationProperties.HelpText="从服务器记录的播放进度继续播放。"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource PrimaryActionButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <controls:AppIcon Data="{StaticResource Icon.Play}" Style="{StaticResource PrimaryActionButtonIcon}" />
                  <TextBlock Text="继续播放" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding AddToQueueCommand}"
                      Visibility="{Binding HasPersonalMediaActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.Name="加入待播" AutomationProperties.AutomationId="Detail.AddToQueue"
                      ToolTip="加入本次播放队列；电视剧加入当前选中的单集" ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource SecondaryActionButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <controls:AppIcon Data="{StaticResource Icon.QueueAdd}" Style="{StaticResource PrimaryActionButtonIcon}" />
                  <TextBlock Text="加入待播" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding RestartPlayCommand}"
                      ToolTip="从头播放"
                      AutomationProperties.Name="从头播放"
                      AutomationProperties.HelpText="忽略续播进度，从开头播放。"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource DetailCompactActionButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <controls:AppIcon Data="{StaticResource Icon.Restart}" Style="{StaticResource DetailCompactActionIcon}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ToggleFavoriteCommand}"
                      ToolTip="添加到收藏或取消收藏；已收藏时再次点击会取消收藏"
                      AutomationProperties.Name="{Binding FavoriteButtonText, Mode=OneWay}"
                      AutomationProperties.HelpText="根据当前收藏状态添加到收藏或取消收藏。"
                      ToolTipService.ShowOnDisabled="True"
                      Style="{StaticResource DetailCompactActionButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <controls:AppIcon Style="{StaticResource DetailFavoriteIcon}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding ToggleWatchLaterCommand}"
                      Visibility="{Binding HasPersonalMediaActions, Converter={StaticResource BooleanToVisibilityConverter}}"
                      AutomationProperties.Name="{Binding WatchLaterButtonText}" AutomationProperties.AutomationId="Detail.WatchLater"
                      ToolTip="{Binding WatchLaterButtonText}" ToolTipService.ShowOnDisabled="True">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource DetailCompactActionButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSavedForLater}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DetailFocusBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <controls:AppIcon Style="{StaticResource DetailWatchLaterIcon}" />
                </StackPanel>
              </Button>
              <Button Command="{Binding TogglePlayedCommand}"
