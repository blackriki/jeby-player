<UserControl x:Class="EmbyPlayer.UI.Pages.PlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls"
             xmlns:pages="clr-namespace:EmbyPlayer.UI.Pages"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Focusable="True"
             Background="#020305"
             PreviewMouseLeftButtonDown="OnRootPreviewMouseLeftButtonDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="PlayerPrimaryText" Color="#F7F9FB" />
    <SolidColorBrush x:Key="PlayerSecondaryText" Color="#B9C1CB" />
    <SolidColorBrush x:Key="PlayerAccent" Color="#52B54B" />

    <Style x:Key="PlayerKeyboardFocus" TargetType="Control">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border Margin="2" BorderBrush="{StaticResource PlayerAccent}" BorderThickness="1" CornerRadius="18" />
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>

    <Style x:Key="PlayerIconButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource PlayerPrimaryText}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerKeyboardFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="20">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#28FFFFFF" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#24FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3DFFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerPrimaryButton" TargetType="Button" BasedOn="{StaticResource PlayerIconButton}">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="#F2FFFFFF" />
      <Setter Property="Foreground" Value="#08100B" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Width="48" Height="48" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#FFFFFFFF" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DDE7E9EB" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerVolumeIconStyle"
           TargetType="controls:AppIcon"
           BasedOn="{StaticResource {x:Type controls:AppIcon}}">
      <Setter Property="Data" Value="{StaticResource Icon.VolumeHigh}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMuted}" Value="True">
          <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Volume}" Value="0">
          <Setter Property="Data" Value="{StaticResource Icon.Mute}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PlayerPopupItem" TargetType="Button">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource PlayerSecondaryText}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#253D2A" />
                <Setter Property="Foreground" Value="{StaticResource PlayerPrimaryText}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#20FFFFFF" />
                <Setter Property="Foreground" Value="{StaticResource PlayerPrimaryText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NextEpisodePrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="{StaticResource PlayerAccent}" />
      <Setter Property="Foreground" Value="#08100B" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#68C961" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#459B40" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SkipSegmentButton" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="Margin" Value="0,0,28,132" />
      <Setter Property="Background" Value="#E610151B" />
      <Setter Property="BorderBrush" Value="#38FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource PlayerPrimaryText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource PlayerKeyboardFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="19"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#EF182129" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6852B54B" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#F0212D36" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NextEpisodeCardActivation" TargetType="ProgressBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#2852B54B" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="11" /></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="SliderRepeatButtonStyle" TargetType="primitives:RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="primitives:RepeatButton">
            <Border Background="{TemplateBinding Background}" CornerRadius="2" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerSliderThumbStyle" TargetType="primitives:Thumb">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="primitives:Thumb">
            <Ellipse Fill="#F7FFFFFF" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerProgressSliderStyle" TargetType="Slider">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{StaticResource PlayerAccent}" />
      <Setter Property="Background" Value="#5AFFFFFF" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="34" Background="Transparent">
              <primitives:Track x:Name="PART_Track" Height="14" Margin="6,0" VerticalAlignment="Center"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <primitives:Track.DecreaseRepeatButton>
                  <primitives:RepeatButton Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" Style="{StaticResource SliderRepeatButtonStyle}" Height="4" VerticalAlignment="Center" />
                </primitives:Track.DecreaseRepeatButton>
                <primitives:Track.IncreaseRepeatButton>
                  <primitives:RepeatButton Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" Style="{StaticResource SliderRepeatButtonStyle}" Height="4" VerticalAlignment="Center" />
                </primitives:Track.IncreaseRepeatButton>
                <primitives:Track.Thumb>
                  <primitives:Thumb Style="{StaticResource PlayerSliderThumbStyle}" />
                </primitives:Track.Thumb>
              </primitives:Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayerVolumeSliderStyle" TargetType="Slider" BasedOn="{StaticResource PlayerProgressSliderStyle}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="142" />
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Width="4" Background="#4CFFFFFF" CornerRadius="2" HorizontalAlignment="Center" />
              <primitives:Track x:Name="PART_Track"
                                Orientation="{TemplateBinding Orientation}"
                                IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <primitives:Track.DecreaseRepeatButton>
                  <primitives:RepeatButton Background="{StaticResource PlayerAccent}" BorderThickness="0" IsTabStop="False">
                    <primitives:RepeatButton.Template><ControlTemplate TargetType="primitives:RepeatButton"><Border Width="4" Background="{TemplateBinding Background}" CornerRadius="2" /></ControlTemplate></primitives:RepeatButton.Template>
                  </primitives:RepeatButton>
                </primitives:Track.DecreaseRepeatButton>
                <primitives:Track.Thumb>
                  <primitives:Thumb Width="11" Height="11"><primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Ellipse Fill="#FFFFFFFF" /></ControlTemplate></primitives:Thumb.Template></primitives:Thumb>
                </primitives:Track.Thumb>
                <primitives:Track.IncreaseRepeatButton>
                  <primitives:RepeatButton Background="Transparent" BorderThickness="0" IsTabStop="False">
                    <primitives:RepeatButton.Template>
                      <ControlTemplate TargetType="primitives:RepeatButton">
                        <Border Width="4" Background="Transparent" CornerRadius="2" />
                      </ControlTemplate>
                    </primitives:RepeatButton.Template>
                  </primitives:RepeatButton>
                </primitives:Track.IncreaseRepeatButton>
              </primitives:Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="PlayerSurface"
        Background="#020305"
        MouseMove="OnPlayerMouseMove"
        MouseLeave="OnPlayerMouseLeave">
    <Grid x:Name="VideoArea" Background="#000000" MouseLeftButtonDown="OnVideoAreaMouseLeftButtonDown"
          MouseLeftButtonUp="OnVideoAreaMouseLeftButtonUp" LostMouseCapture="OnVideoSurfaceLostMouseCapture">
      <controls:PlayerVideoHost x:Name="VideoHost" />
      <TextBlock Text="正在加载"
                 Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                 Foreground="#A8B0BA" FontSize="22" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <Grid x:Name="OverlayRoot"
          Background="#01000000"
          Focusable="True"
          PreviewMouseLeftButtonDown="OnOverlayRootPreviewMouseLeftButtonDown"
          MouseMove="OnPlayerMouseMove"
          MouseLeave="OnPlayerMouseLeave"
          MouseLeftButtonDown="OnVideoAreaMouseLeftButtonDown"
          MouseLeftButtonUp="OnVideoAreaMouseLeftButtonUp" LostMouseCapture="OnVideoSurfaceLostMouseCapture">
    <Border Panel.ZIndex="30" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
            Padding="16" Margin="20,60,20,20" CornerRadius="8" Background="#F0151A20" BorderBrush="#4B252B" BorderThickness="1"
            MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8A8A" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding RecoveryStatusText}" Margin="0,8,0,0" Foreground="#A8B0BA" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
          <Button Content="原位置重试" Command="{Binding RetryPlaybackCommand}" IsEnabled="{Binding CanRetryPlayback}"
                  Style="{StaticResource PlayerPopupItem}" AutomationProperties.Name="原位置重试" />
          <Button Content="返回详情" Command="{Binding BackCommand}" Margin="8,0,0,0" Style="{StaticResource PlayerPopupItem}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid x:Name="WindowResizeHitZones"
          Panel.ZIndex="5"
          Focusable="False"
          KeyboardNavigation.TabNavigation="None">
      <Border x:Name="PlayerCaptionHitZone" Height="103" Margin="8,8,8,0" VerticalAlignment="Top" Background="Transparent" Tag="Caption" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Height="8" Margin="8,0" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS" Tag="Top" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Height="8" Margin="8,0" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNS" Tag="Bottom" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Width="8" Margin="0,8" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWE" Tag="Left" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Width="8" Margin="0,8" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWE" Tag="Right" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" Tag="TopLeft" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" Tag="TopRight" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" Tag="BottomLeft" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
      <Border Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" Tag="BottomRight" PreviewMouseLeftButtonDown="OnResizeHitZoneMouseLeftButtonDown" />
    </Grid>

    <Grid x:Name="ControlsLayer" Panel.ZIndex="10">
      <Grid x:Name="TopChrome" Height="111" VerticalAlignment="Top" MouseEnter="OnControlsMouseEnter" MouseLeave="OnControlsMouseLeave" PreviewMouseLeftButtonDown="OnTopChromePreviewMouseLeftButtonDown">
        <Rectangle IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#C0000000" Offset="0" />
              <GradientStop Color="#70000000" Offset="0.52" />
              <GradientStop Color="#00000000" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Grid x:Name="PlayerHeader" Height="44" Margin="24,23,18,0" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Command="{Binding BackCommand}"
                  Style="{StaticResource PlayerIconButton}"
                  ToolTip="返回详情" AutomationProperties.Name="返回详情"
                  AutomationProperties.HelpText="停止播放并返回媒体详情页。">
            <controls:AppIcon Data="{StaticResource Icon.Back}" Style="{StaticResource NavigationLineIcon}" Margin="-2,0,2,0" />
          </Button>
          <Grid x:Name="PlayerLogoContainer" Grid.Column="2"
                Height="30"
                MaxWidth="150"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="当前媒体标志">
            <Image Width="22"
                   Height="22"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Source="{Binding Owner.Icon, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                   Stretch="Uniform">
              <Image.Style>
                <Style TargetType="Image">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsImageLoaded, ElementName=OverlayPlayerLogo}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Image.Style>
            </Image>
            <controls:AuthenticatedImage x:Name="OverlayPlayerLogo"
                                         Height="30"
                                         MaxWidth="150"
                                         MaxHeight="30"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         ImageUrl="{Binding LogoUrl, Mode=OneWay}"
                                         ShowPlaceholder="False"
                                         Stretch="Uniform" />
          </Grid>
          <StackPanel Grid.Column="4" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title, Mode=OneWay}" Foreground="{StaticResource PlayerPrimaryText}"
                       FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PlayerMetadata" Text="{Binding MediaMetadataText, Mode=OneWay}"
                       Visibility="{Binding HasMediaMetadata, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,3,0,0" Foreground="{StaticResource PlayerSecondaryText}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal">
            <Button x:Name="MiniPlayerButton" Click="OnMiniPlayerButtonClick" Style="{StaticResource PlayerIconButton}"
                    ToolTip="迷你播放器" AutomationProperties.Name="迷你播放器" AutomationProperties.AutomationId="MiniPlayerButton">
              <controls:AppIcon x:Name="MiniPlayerIcon" Data="M 3,4 L 21,4 21,20 3,20 Z M 12,12 L 19,12 19,18 12,18 Z" RenderMode="Stroke" Size="20" />
            </Button>
            <Button x:Name="PinPlayerButton" Click="OnPinPlayerButtonClick" Style="{StaticResource PlayerIconButton}"
                    ToolTip="窗口置顶" AutomationProperties.Name="窗口置顶" AutomationProperties.AutomationId="PinPlayerButton">
              <controls:AppIcon Data="M 8,3 L 16,3 M 9,3 L 9,10 6,14 18,14 15,10 15,3 M 12,14 L 12,22" RenderMode="Stroke" Size="20" />
            </Button>
          <Button x:Name="MinimizeWindowButton"
                  Width="44"
                  Height="44"
                  VerticalAlignment="Top"
                  Click="OnMinimizeWindowButtonClick"
                  Style="{StaticResource PlayerIconButton}"
                  ToolTip="最小化"
                  AutomationProperties.Name="最小化"
                  AutomationProperties.AutomationId="MinimizePlayerWindowButton">
            <controls:AppIcon Data="{StaticResource Icon.WindowMinimize}" RenderMode="Stroke" Size="20" />
          </Button>
          </StackPanel>
          <Button x:Name="CloseWindowButton"
                  Grid.Column="6"
                  Width="44"
                  Height="44"
                  VerticalAlignment="Top"
                  Click="OnCloseWindowButtonClick"
                  Style="{StaticResource PlayerIconButton}"
                  ToolTip="关闭"
                  AutomationProperties.Name="关闭">
            <controls:AppIcon Data="{StaticResource Icon.Close}" RenderMode="Stroke" Size="20" />
          </Button>
        </Grid>
      </Grid>

      <Button x:Name="CenterPlayButton" Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"
              Visibility="{Binding IsPaused, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              Command="{Binding TogglePlayPauseCommand}" Background="#EFFFFFFF" Foreground="#08100B" BorderThickness="0" Cursor="Hand"
              ToolTip="继续播放" AutomationProperties.Name="继续播放">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CenterChrome" Background="{TemplateBinding Background}" CornerRadius="38"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CenterChrome" Property="Background" Value="#FFFFFFFF" /></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <controls:AppIcon Data="{StaticResource Icon.Play}" RenderMode="Fill" Size="31" />
      </Button>

      <Grid x:Name="BottomChrome" Height="238" VerticalAlignment="Bottom" MouseEnter="OnControlsMouseEnter" MouseLeave="OnControlsMouseLeave">
        <Rectangle IsHitTestVisible="False">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#00000000" Offset="0" />
              <GradientStop Color="#69000000" Offset="0.34" />
              <GradientStop Color="#D6000000" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Grid x:Name="PlayerBottomContent" Margin="30,0,30,24" VerticalAlignment="Bottom">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

          <Grid Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding CurrentTimeText, Mode=OneWay}" Foreground="{StaticResource PlayerSecondaryText}" FontSize="12" VerticalAlignment="Center" />
              <Border x:Name="SeekHitArea" Grid.Column="1" Background="Transparent"
                      AutomationProperties.Name="播放进度">
                <controls:SettingsSlider x:Name="SeekSlider" Value="{Binding SeekPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanSeek, Mode=OneWay}" Style="{StaticResource PlayerProgressSliderStyle}"
                                         ValueChanged="OnSeekSliderValueChanged" />
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}" Foreground="{StaticResource PlayerSecondaryText}"
                         FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource PlayerPrimaryButton}"
                        ToolTip="{Binding PlayPauseButtonText, Mode=OneWay}" AutomationProperties.Name="{Binding PlayPauseButtonText, Mode=OneWay}">
                  <controls:AppIcon RenderMode="Fill" Size="20">
                    <controls:AppIcon.Style>
                      <Style TargetType="controls:AppIcon" BasedOn="{StaticResource {x:Type controls:AppIcon}}">
                        <Setter Property="Data" Value="{StaticResource Icon.Pause}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Data" Value="{StaticResource Icon.Play}" /></DataTrigger></Style.Triggers>
                      </Style>
                    </controls:AppIcon.Style>
                  </controls:AppIcon>
                </Button>
                <Button Command="{Binding PlayNextEpisodeCommand}" Visibility="{Binding HasNextEpisode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource PlayerIconButton}" Margin="8,4,0,4" ToolTip="播放下一集" AutomationProperties.Name="播放下一集">
                  <controls:AppIcon Data="{StaticResource Icon.Next}" RenderMode="Stroke" Size="20" />
                </Button>
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="VolumeButton" Click="OnVolumeButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Style="{StaticResource PlayerIconButton}" ToolTip="音量" AutomationProperties.Name="音量">
                  <controls:AppIcon Style="{StaticResource PlayerVolumeIconStyle}" RenderMode="Stroke" Size="21" />
                </Button>
                <StackPanel x:Name="SecondaryPlayerActions" Orientation="Horizontal">
                <Button x:Name="SubtitleMenuButton" Click="OnSubtitleMenuButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Style="{StaticResource PlayerIconButton}" Margin="4,0,0,0" ToolTip="字幕" AutomationProperties.Name="字幕">
                  <controls:AppIcon Data="{StaticResource Icon.Subtitle}" RenderMode="Stroke" Size="21" />
                </Button>
                <Button x:Name="AudioMenuButton" Click="OnAudioMenuButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Style="{StaticResource PlayerIconButton}" Margin="4,0,0,0" ToolTip="音轨" AutomationProperties.Name="音轨">
                  <controls:AppIcon Data="{StaticResource Icon.AudioTrack}" RenderMode="Stroke" Size="21" />
                </Button>
                <Button x:Name="QualityMenuButton" Click="OnQualityMenuButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Content="画质" Style="{StaticResource PlayerIconButton}" Width="56" Margin="4,0,0,0"
                        ToolTip="{Binding QualityButtonText}" AutomationProperties.Name="画质" />
                <Button x:Name="SpeedMenuButton" Click="OnSpeedMenuButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Content="{Binding PlaybackSpeedText}" Style="{StaticResource PlayerIconButton}" Width="52" Margin="4,0,0,0"
                        ToolTip="播放速度 · 长按画面临时 2 倍速" AutomationProperties.Name="播放速度"
                        IsEnabled="{Binding CanChangePlaybackSpeed}" />
                <Button x:Name="QueueMenuButton" Click="OnQueueMenuButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Content="{Binding QueueButtonText}" Style="{StaticResource PlayerIconButton}" Width="96" Margin="4,0,0,0"
                        Visibility="{Binding HasPlaybackQueue, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="{Binding QueueButtonToolTip}" AutomationProperties.Name="{Binding QueueButtonToolTip}" />
                </StackPanel>
                <Button x:Name="MoreMenuButton" Click="OnMoreMenuButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Style="{StaticResource PlayerIconButton}" Margin="4,0,0,0" Visibility="Collapsed"
                        ToolTip="更多播放选项" AutomationProperties.Name="更多播放选项" Content="•••" FontSize="18" />
                <Button Click="OnFullscreenButtonClick" Style="{StaticResource PlayerIconButton}" Margin="4,0,0,0"
                        ToolTip="{Binding FullscreenButtonTooltip, Mode=OneWay}" AutomationProperties.Name="{Binding FullscreenButtonTooltip, Mode=OneWay}">
                  <controls:AppIcon RenderMode="Stroke" Size="21">
                    <controls:AppIcon.Style>
                      <Style TargetType="controls:AppIcon" BasedOn="{StaticResource {x:Type controls:AppIcon}}">
                        <Setter Property="Data" Value="{StaticResource Icon.FullscreenEnter}" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsFullscreen}" Value="True"><Setter Property="Data" Value="{StaticResource Icon.FullscreenExit}" /></DataTrigger></Style.Triggers>
                      </Style>
                    </controls:AppIcon.Style>
                  </controls:AppIcon>
                </Button>
                <Button x:Name="PlaybackInfoButton" Click="OnPlaybackInfoButtonClick" PreviewMouseLeftButtonDown="OnPopupTriggerMouseDown"
                        Style="{StaticResource PlayerIconButton}" Margin="4,0,0,0" ToolTip="播放信息" AutomationProperties.Name="播放信息">
                  <controls:AppIcon Data="{StaticResource Icon.Info}" RenderMode="Stroke" Size="21" />
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <Button x:Name="SkipSegmentButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="21"
            Visibility="{Binding IsSkipSegmentVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            Command="{Binding SkipSegmentCommand}"
            Style="{StaticResource SkipSegmentButton}"
            ToolTip="{Binding SkipSegmentButtonText, Mode=OneWay}"
            AutomationProperties.Name="{Binding SkipSegmentButtonText, Mode=OneWay}"
            AutomationProperties.AutomationId="SkipPlaybackSegmentButton">
      <TextBlock Text="{Binding SkipSegmentButtonText, Mode=OneWay}" />
    </Button>

    <Border x:Name="NextEpisodeCard"
            Width="376"
            MinWidth="340"
            MaxWidth="380"
            Height="96"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#E610151B"
            BorderBrush="#28FFFFFF"
            BorderThickness="1"
            CornerRadius="12"
            Panel.ZIndex="20"
            MouseEnter="OnNextEpisodeCardMouseEnter"
            MouseLeave="OnNextEpisodeCardMouseLeave"
            AutomationProperties.Name="下一集提示">
      <Border.RenderTransform><TranslateTransform Y="0" /></Border.RenderTransform>
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Setter Property="Margin" Value="0,0,28,132" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNextEpisodePromptVisible, Mode=OneWay}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.18" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding AutoPlayCountdownProgress, Mode=OneWay}"
                     ValueChanged="OnNextEpisodeActivationValueChanged"
                     Style="{StaticResource NextEpisodeCardActivation}" />
        <Grid Margin="15,12,12,12" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding NextEpisode.Title, Mode=OneWay}"
                     Margin="0,0,12,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                     Foreground="{StaticResource PlayerPrimaryText}" FontSize="15" FontWeight="SemiBold" />
          <Button Grid.Column="1" Grid.RowSpan="2" Content="立即播放"
                  Command="{Binding PlayNextEpisodeCommand}"
                  VerticalAlignment="Center"
                  Style="{StaticResource NextEpisodePrimaryButton}"
                  AutomationProperties.AutomationId="PlayNextEpisodeNowButton" />
          <Button Grid.Column="2" Grid.RowSpan="2"
                  Width="28" Height="28" Margin="6,0,0,0"
                  Command="{Binding CancelAutoPlayNextEpisodeCommand}"
                  Style="{StaticResource PlayerIconButton}"
                  ToolTip="继续观看片尾"
                  AutomationProperties.Name="继续观看片尾"
                  AutomationProperties.AutomationId="CancelAutoPlayNextEpisodeButton">
            <controls:AppIcon Data="{StaticResource Icon.Close}" RenderMode="Stroke" Size="14" />
          </Button>
          <TextBlock Grid.Row="1" Grid.Column="0"
                     Text="{Binding NextEpisodeStatusText, Mode=OneWay}"
                     Margin="0,4,12,0" VerticalAlignment="Center"
                     Foreground="#B5C1CC" FontSize="12"
                     AutomationProperties.AutomationId="AutoPlayNextEpisodeCountdown" />
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="KeyboardSeekFeedback" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12"
            Background="#E610151B" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="10" Panel.ZIndex="30"
            IsHitTestVisible="False" Visibility="{Binding IsKeyboardSeekActive, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel>
        <TextBlock Text="{Binding KeyboardSeekFeedbackText}" Foreground="{StaticResource PlayerPrimaryText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="长按加速定位 · 松开跳转" Foreground="{StaticResource PlayerSecondaryText}" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <Border x:Name="SpeedFeedback" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0" Padding="18,10"
            Background="#DD10141A" CornerRadius="18" Panel.ZIndex="22"
            Visibility="{Binding IsSpeedFeedbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding SpeedFeedbackText}" Foreground="{StaticResource PlayerPrimaryText}" FontSize="14"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        <Button Content="重试" Command="{Binding RetryPlaybackSpeedCommand}" Style="{StaticResource PlayerPopupItem}" Margin="10,0,0,0"
                Visibility="{Binding HasPlaybackSpeedError, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </Border>
    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreMenuButton}" Placement="Top" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="220" Padding="8" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <StackPanel>
          <StackPanel.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource PlayerPopupItem}">
              <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,5" />
            </Style>
          </StackPanel.Resources>
          <TextBlock Text="播放选项" Foreground="{StaticResource PlayerSecondaryText}" Margin="12,6,12,8" />
          <Button Content="字幕" Tag="Subtitle" Click="OnMoreOptionClick" />
          <Button Content="音轨" Tag="Audio" Click="OnMoreOptionClick" />
          <Button Content="画质" Tag="Quality" Click="OnMoreOptionClick" />
          <Button Tag="Speed" Click="OnMoreOptionClick" IsEnabled="{Binding CanChangePlaybackSpeed}" AutomationProperties.Name="播放速度">
            <Grid><TextBlock Text="播放速度" /><TextBlock Text="{Binding PlaybackSpeedText}" HorizontalAlignment="Right" Foreground="{StaticResource PlayerSecondaryText}" /></Grid>
          </Button>
          <Button Content="{Binding QueueButtonText}" Tag="Queue" Click="OnMoreOptionClick"
                  Visibility="{Binding HasPlaybackQueue, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Button Content="播放信息" Tag="Info" Click="OnMoreOptionClick" />
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedMenuButton}" Placement="Top" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="190" Padding="8" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <StackPanel>
          <TextBlock Text="播放速度" Margin="10,7,10,8" Foreground="{StaticResource PlayerPrimaryText}" FontSize="14" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding PlaybackSpeedOptions}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Click="OnPlaybackSpeedClick" Style="{StaticResource PlayerPopupItem}" AutomationProperties.Name="{Binding Label}">
                <Grid><TextBlock Text="{Binding Label}" />
                  <TextBlock Text="✓" HorizontalAlignment="Right" Foreground="{StaticResource PlayerAccent}"
                             Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="长按画面临时 2×，松开恢复原速度" TextWrapping="Wrap" Margin="10,8" FontSize="11" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Text="{Binding PlayerOptionsMessage}" TextWrapping="Wrap" Margin="10,0,10,8" Foreground="#FFCB86" />
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}" Placement="Top" HorizontalOffset="-12" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="True" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="62" Height="198" Padding="12,13" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <Grid Background="Transparent">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="{Binding VolumePercentText, Mode=OneWay}" Foreground="{StaticResource PlayerSecondaryText}" FontSize="11" TextAlignment="Center" />
          <controls:SettingsSlider x:Name="VolumeSlider" Grid.Row="1" Margin="0,8" HorizontalAlignment="Center"
                                   Value="{Binding Volume, Mode=OneWay}" Minimum="0" Maximum="100" Orientation="Vertical"
                                   Style="{StaticResource PlayerVolumeSliderStyle}"
                                   ValueChanged="OnVolumeSliderValueChanged"
                                   AutomationProperties.Name="音量" />
          <Button Grid.Row="2" Command="{Binding ToggleMuteCommand}" Style="{StaticResource PlayerIconButton}" Width="30" Height="30"
                  ToolTip="{Binding MuteButtonText, Mode=OneWay}" AutomationProperties.Name="{Binding MuteButtonText, Mode=OneWay}">
            <controls:AppIcon Style="{StaticResource PlayerVolumeIconStyle}" RenderMode="Stroke" Size="18" />
          </Button>
        </Grid>
      </Border>
    </Popup>

    <Popup x:Name="SubtitlePopup" PlacementTarget="{Binding ElementName=SubtitleMenuButton}" Placement="Top" HorizontalOffset="-106" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="330" Padding="8" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Background="Transparent">
          <TextBlock Text="字幕" Margin="10,7,10,8" Foreground="{StaticResource PlayerPrimaryText}" FontSize="14" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding SubtitleTracks, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="OnSubtitleTrackButtonClick" Style="{StaticResource PlayerPopupItem}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayText, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource PlayerAccent}" Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Height="1" Background="#28FFFFFF" Margin="10,10" />
          <Button x:Name="ImportSubtitleButton" Content="＋ 载入本地字幕…" Click="OnImportSubtitleClick" IsEnabled="{Binding CanImportLocalSubtitle}"
                  Style="{StaticResource PlayerPopupItem}" ToolTip="选择 SRT、ASS、SSA、VTT 文件，也可拖入播放窗口" />
          <TextBlock Text="字幕调节" Margin="10,8,10,6" Foreground="{StaticResource PlayerPrimaryText}" FontWeight="SemiBold" />
          <Grid Margin="10,0" IsEnabled="{Binding CanAdjustSubtitles}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="68"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="时间偏移" VerticalAlignment="Center" Foreground="{StaticResource PlayerSecondaryText}" />
            <Button Grid.Column="1" Content="−" Command="{Binding AdjustSubtitleCommand}" CommandParameter="earlier" Style="{StaticResource PlayerPopupItem}" ToolTip="字幕提前 0.1 秒" AutomationProperties.Name="字幕提前 0.1 秒" />
            <TextBlock Grid.Column="2" Text="{Binding SubtitleDelayText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PlayerPrimaryText}" />
            <Button Grid.Column="3" Content="+" Command="{Binding AdjustSubtitleCommand}" CommandParameter="later" Style="{StaticResource PlayerPopupItem}" ToolTip="字幕延后 0.1 秒" AutomationProperties.Name="字幕延后 0.1 秒" />
            <TextBlock Grid.Row="1" Text="字号比例" VerticalAlignment="Center" Foreground="{StaticResource PlayerSecondaryText}" />
            <Button Grid.Row="1" Grid.Column="1" Content="−" Command="{Binding AdjustSubtitleCommand}" CommandParameter="smaller" Style="{StaticResource PlayerPopupItem}" ToolTip="缩小字幕" AutomationProperties.Name="缩小字幕" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SubtitleScaleText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PlayerPrimaryText}" />
            <Button Grid.Row="1" Grid.Column="3" Content="+" Command="{Binding AdjustSubtitleCommand}" CommandParameter="larger" Style="{StaticResource PlayerPopupItem}" ToolTip="放大字幕" AutomationProperties.Name="放大字幕" />
            <TextBlock Grid.Row="2" Text="垂直位置" VerticalAlignment="Center" Foreground="{StaticResource PlayerSecondaryText}" />
            <Button Grid.Row="2" Grid.Column="1" Content="↑" Command="{Binding AdjustSubtitleCommand}" CommandParameter="up" Style="{StaticResource PlayerPopupItem}" ToolTip="上移字幕" AutomationProperties.Name="上移字幕" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SubtitlePositionText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource PlayerPrimaryText}" />
            <Button Grid.Row="2" Grid.Column="3" Content="↓" Command="{Binding AdjustSubtitleCommand}" CommandParameter="down" Style="{StaticResource PlayerPopupItem}" ToolTip="下移字幕" AutomationProperties.Name="下移字幕" />
          </Grid>
          <Button Content="恢复默认调节" Command="{Binding AdjustSubtitleCommand}" CommandParameter="reset" Style="{StaticResource PlayerPopupItem}" Margin="0,4,0,0" />
          <TextBlock Text="仅本次播放有效。正值让字幕延后；位置 100% 为底部。图片字幕及部分自带排版字幕不支持字号或位置调整。" Margin="10,4,10,8" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Text="{Binding PlayerOptionsMessage}" Margin="10,0,10,4" TextWrapping="Wrap" Foreground="#FFCB86" />
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Popup>

    <Popup x:Name="AudioPopup" PlacementTarget="{Binding ElementName=AudioMenuButton}" Placement="Top" HorizontalOffset="-106" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="282" Padding="8" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <StackPanel Background="Transparent">
          <TextBlock Text="音轨" Margin="10,7,10,8" Foreground="{StaticResource PlayerPrimaryText}" FontSize="14" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding AudioTracks, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Click="OnAudioTrackButtonClick" Style="{StaticResource PlayerPopupItem}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayText, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Ellipse Grid.Column="1" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource PlayerAccent}" Visibility="{Binding IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="PlaybackInfoPopup" PlacementTarget="{Binding ElementName=PlaybackInfoButton}" Placement="Top" HorizontalOffset="-260" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="320" Padding="18" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <StackPanel>
          <TextBlock Text="播放信息" Foreground="{StaticResource PlayerPrimaryText}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
          <TextBlock Text="实际视频分辨率" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Text="{Binding DecodedResolutionText}" Foreground="{StaticResource PlayerPrimaryText}" Margin="0,3,0,12" />
          <TextBlock Text="实际视频编码" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Text="{Binding DecodedVideoCodecText}" Foreground="{StaticResource PlayerPrimaryText}" Margin="0,3,0,12" />
          <TextBlock Text="播放方式" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Text="{Binding PlaybackMethodText}" Foreground="{StaticResource PlayerPrimaryText}" Margin="0,3,0,12" TextWrapping="Wrap" />
          <Border Height="1" Background="#28FFFFFF" Margin="0,0,0,12" />
          <TextBlock Text="源媒体分辨率 / 编码" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Foreground="{StaticResource PlayerPrimaryText}" Margin="0,3,0,12"><Run Text="{Binding SourceResolutionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SourceVideoCodecText, Mode=OneWay}"/></TextBlock>
          <TextBlock Text="源媒体总码率" Foreground="{StaticResource PlayerSecondaryText}" />
          <TextBlock Text="{Binding SourceBitrateText}" Foreground="{StaticResource PlayerPrimaryText}" Margin="0,3,0,12" />
          <Button Content="刷新播放信息" Command="{Binding RefreshTechnicalInfoCommand}" Style="{StaticResource PlayerPopupItem}" />
          <Button Content="快捷键说明" Style="{StaticResource PlayerPopupItem}" AutomationProperties.Name="快捷键说明">
            <Button.ToolTip><ToolTip><TextBlock Text="{Binding ShortcutHelpText}" MaxWidth="420" TextWrapping="Wrap" /></ToolTip></Button.ToolTip>
          </Button>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=QueueMenuButton}" Placement="Top" HorizontalOffset="-500" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="650" MaxHeight="510" Padding="8" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8">
            <Button Content="播放下一待播项" Command="{Binding PlayNextQueuedCommand}" Style="{StaticResource PlayerPopupItem}" />
            <TextBlock Text="{Binding PlayerOptionsMessage}" Foreground="#FFCB86" TextWrapping="Wrap" />
          </StackPanel>
          <pages:PlaybackQueuePage DataContext="{Binding QueueViewModel}" IsEmbedded="True" />
        </DockPanel>
      </Border>
    </Popup>
    <Popup x:Name="QualityPopup" PlacementTarget="{Binding ElementName=QualityMenuButton}" Placement="Top" HorizontalOffset="-180" VerticalOffset="6"
           AllowsTransparency="True" StaysOpen="False" Opened="OnPopupOpened" Closed="OnPopupClosed">
      <Border Width="292" Padding="8" Background="#F010141A" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="9"
              MouseEnter="OnPopupMouseEnter" MouseLeave="OnPopupMouseLeave">
        <StackPanel>
          <TextBlock Text="画质与码率" Margin="12,8,12,10" Foreground="{StaticResource PlayerPrimaryText}" FontSize="15" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding QualityOptions}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Style="{StaticResource PlayerPopupItem}"
                      Command="{Binding DataContext.SelectQualityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                      CommandParameter="{Binding Quality}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Text="✓" Foreground="{StaticResource PlayerAccent}" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding QualityStatusText}" Margin="12,10,12,4" Foreground="{StaticResource PlayerSecondaryText}" TextWrapping="Wrap" />
          <TextBlock Text="分辨率和码率为上限，实际效果取决于片源与服务器转码能力。" Margin="12,0,12,8" FontSize="11" Foreground="{StaticResource PlayerSecondaryText}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PlayerOptionsMessage}" Margin="12,0,12,8" Foreground="#FFCB86" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Popup>
    </Grid>
  </Grid>
</UserControl>
