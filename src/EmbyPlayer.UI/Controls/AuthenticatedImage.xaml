<UserControl x:Class="EmbyPlayer.UI.Controls.AuthenticatedImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootGrid"
        Background="#151A20"
        ClipToBounds="True"
        SnapsToDevicePixels="True">
    <Border x:Name="PlaceholderBorder"
            Background="#171C23"
            BorderBrush="#252B34"
            BorderThickness="1">
      <TextBlock x:Name="PlaceholderTextBlock"
                 Text="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontSize="12"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis" />
    </Border>
    <Image x:Name="ImageElement"
           Stretch="{Binding Stretch, RelativeSource={RelativeSource AncestorType=UserControl}}"
           HorizontalAlignment="{Binding ImageHorizontalAlignment, RelativeSource={RelativeSource AncestorType=UserControl}}"
           VerticalAlignment="Center"
           SnapsToDevicePixels="True" />
  </Grid>
</UserControl>
