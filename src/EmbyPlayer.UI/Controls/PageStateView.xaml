<UserControl x:Class="EmbyPlayer.UI.Controls.PageStateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls"
             x:Name="Root"
             Focusable="False"
             IsTabStop="False">
  <UserControl.Style>
    <Style TargetType="UserControl">
      <Setter Property="Visibility" Value="Visible" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentState, ElementName=Root}" Value="Content">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Style>
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel x:Name="LoadingPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentState, ElementName=Root}" Value="Loading">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <controls:LoadingSpinner Width="32" Height="32" />
      <TextBlock Text="{Binding LoadingMessage, ElementName=Root}"
                 Margin="0,14,0,0"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 FontSize="14"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel x:Name="EmptyPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentState, ElementName=Root}" Value="Empty">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <controls:AppIcon Data="{Binding EmptyIcon, ElementName=Root}"
                        RenderMode="Stroke"
                        Size="32"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Margin="0,0,0,14" />
      <TextBlock Text="{Binding EmptyTitle, ElementName=Root}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontSize="18"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                 Margin="0,7,0,0"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 FontSize="13"
                 LineHeight="21"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel x:Name="ErrorPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentState, ElementName=Root}" Value="Error">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>
      <controls:AppIcon Data="{Binding ErrorIcon, ElementName=Root}"
                        RenderMode="Stroke"
                        Size="32"
                        Foreground="#FF7777"
                        Margin="0,0,0,14" />
      <TextBlock Text="{Binding ErrorTitle, ElementName=Root}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 FontSize="20"
                 FontWeight="SemiBold"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorMessage, ElementName=Root}"
                 Margin="0,9,0,0"
                 Foreground="#FF8A8A"
                 FontSize="13"
                 LineHeight="21"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorHint, ElementName=Root}"
                 Margin="0,6,0,0"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 FontSize="13"
                 LineHeight="21"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Command="{Binding RetryCommand, ElementName=Root}"
              Visibility="{Binding ShowRetry, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
              IsEnabled="{Binding IsRetryEnabled, ElementName=Root}"
              Margin="0,20,0,0"
              HorizontalAlignment="Center"
              ToolTip="{Binding RetryToolTip, ElementName=Root}"
              AutomationProperties.Name="{Binding RetryAutomationName, ElementName=Root}"
              Style="{StaticResource AppPrimaryButtonStyle}">
        <StackPanel Orientation="Horizontal">
          <controls:AppIcon Data="{StaticResource Icon.Retry}"
                            RenderMode="Stroke"
                            Size="17"
                            Margin="0,0,9,0" />
          <TextBlock Text="{Binding RetryButtonText, ElementName=Root}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
