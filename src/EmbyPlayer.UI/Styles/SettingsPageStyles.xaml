<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives">
  <SolidColorBrush x:Key="SettingsPageBackgroundBrush" Color="#080C12" />
  <SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#0E1620" />
  <SolidColorBrush x:Key="SettingsEmphasisSurfaceBrush" Color="#111923" />
  <SolidColorBrush x:Key="SettingsControlBrush" Color="#151D27" />
  <SolidColorBrush x:Key="SettingsHoverBrush" Color="#1D2834" />
  <SolidColorBrush x:Key="SettingsSelectedBrush" Color="#121F1A" />
  <SolidColorBrush x:Key="SettingsDividerBrush" Color="#26333F" />
  <SolidColorBrush x:Key="SettingsBorderBrush" Color="#324252" />
  <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#737F8D" />
  <SolidColorBrush x:Key="SettingsAccentBrush" Color="#52B54B" />
  <SolidColorBrush x:Key="SettingsAccentHoverBrush" Color="#63C85B" />
  <SolidColorBrush x:Key="SettingsAccentPressedBrush" Color="#449F43" />
  <SolidColorBrush x:Key="SettingsFocusBrush" Color="#78D36F" />
  <SolidColorBrush x:Key="SettingsDangerBrush" Color="#FF7777" />
  <SolidColorBrush x:Key="SettingsDangerSurfaceBrush" Color="#31191E" />

  <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="38" />
  </Style>

  <Style x:Key="SettingsPageDescription" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#A6B1BE" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="SettingsGroupTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <Style x:Key="SettingsKeyboardFocusVisual" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2"
                  BorderBrush="{StaticResource SettingsFocusBrush}"
                  BorderThickness="2"
                  CornerRadius="10" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsRowTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="22" />
  </Style>

  <Style x:Key="SettingsRowDescription" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#A6B1BE" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style x:Key="SettingsSidebarItem" TargetType="RadioButton">
    <Setter Property="Height" Value="44" />
    <Setter Property="Foreground" Value="#A6B1BE" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsKeyboardFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="ItemChrome"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8">
            <Grid>
              <Border x:Name="SelectionMark"
                      Width="3"
                      Height="30"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      CornerRadius="2" />
              <ContentPresenter Margin="14,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="#0D151D" />
              <Setter Property="Foreground" Value="#F4F7FB" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
              <Setter TargetName="SelectionMark" Property="Background" Value="{StaticResource SettingsAccentBrush}" />
              <Setter Property="Foreground" Value="#F4F7FB" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemChrome" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSidebarIcon"
         TargetType="{x:Type controls:AppIcon}"
         BasedOn="{StaticResource {x:Type controls:AppIcon}}">
    <Setter Property="Size" Value="20" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <Style x:Key="SettingsSearchBox" TargetType="TextBox">
    <Setter Property="Height" Value="42" />
    <Setter Property="Background" Value="#101721" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="CaretBrush" Value="#F4F7FB" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="42,0,34,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="SearchChrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <Grid>
              <controls:AppIcon Data="{StaticResource Icon.Search}"
                                Style="{StaticResource SearchInputIcon}"
                                Margin="14,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
              <TextBlock x:Name="Placeholder"
                         Text="搜索设置"
                         Foreground="#737F8D"
                         FontSize="13"
                         Margin="42,0,12,0"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         IsHitTestVisible="False" />
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Stretch" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="{x:Null}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="SearchChrome" Property="BorderBrush" Value="{StaticResource SettingsFocusBrush}" />
              <Setter TargetName="SearchChrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="SearchChrome" Property="BorderBrush" Value="#425464" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSearchResultButton" TargetType="Button">
    <Setter Property="MinHeight" Value="74" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="22,14,18,14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource SettingsSurfaceBrush}" />
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ResultChrome"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="10">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ResultChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ResultChrome" Property="Background" Value="{StaticResource SettingsSelectedBrush}" />
              <Setter TargetName="ResultChrome" Property="Opacity" Value="0.84" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ResultChrome" Property="BorderBrush" Value="{StaticResource SettingsFocusBrush}" />
              <Setter TargetName="ResultChrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ResultChrome" Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSurface" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SettingsSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style x:Key="SettingsEmphasisSurface"
         TargetType="Border"
         BasedOn="{StaticResource SettingsSurface}">
    <Setter Property="Background" Value="{StaticResource SettingsEmphasisSurfaceBrush}" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style x:Key="SettingsFirstRow" TargetType="Border">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="Padding" Value="24,14" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="SettingsRow"
         TargetType="Border"
         BasedOn="{StaticResource SettingsFirstRow}">
    <Setter Property="Margin" Value="24,0" />
    <Setter Property="Padding" Value="0,14" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <Style x:Key="SettingsToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Background" Value="#273649" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="48" Height="28">
            <Border x:Name="ToggleTrack"
                    Background="{TemplateBinding Background}"
                    CornerRadius="14" />
            <Ellipse x:Name="ToggleThumb"
                     Width="20"
                     Height="20"
                     Margin="4"
                     HorizontalAlignment="Left"
                     Fill="#EEF3F7">
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="3"
                                  Direction="270"
                                  Opacity="0.35"
                                  ShadowDepth="1" />
              </Ellipse.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ToggleTrack" Property="Background" Value="{StaticResource SettingsAccentBrush}" />
              <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.76" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{StaticResource SettingsFocusBrush}" />
              <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.38" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSliderThumb" TargetType="{x:Type primitives:Thumb}">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
          <Grid x:Name="ThumbVisual"
                Width="24"
                Height="24"
                Background="Transparent"
                RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Ellipse Width="22" Height="22" Fill="#3352B54B" />
            <Ellipse Width="16"
                     Height="16"
                     Fill="#F2F6F8"
                     Stroke="{StaticResource SettingsAccentBrush}"
                     StrokeThickness="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbVisual" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbVisual" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="1.08" ScaleY="1.08" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSliderRepeatButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsSlider" TargetType="{x:Type controls:SettingsSlider}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Width" Value="264" />
    <Setter Property="IsMoveToPointEnabled" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SettingsSlider}">
          <Grid Background="Transparent">
            <primitives:Track x:Name="PART_Track"
                              Margin="4,0"
                              IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <primitives:Track.DecreaseRepeatButton>
                <RepeatButton Background="{StaticResource SettingsAccentBrush}"
                              Command="{x:Static Slider.DecreaseLarge}"
                              Style="{StaticResource SettingsSliderRepeatButton}" />
              </primitives:Track.DecreaseRepeatButton>
              <primitives:Track.Thumb>
                <primitives:Thumb Style="{StaticResource SettingsSliderThumb}" />
              </primitives:Track.Thumb>
              <primitives:Track.IncreaseRepeatButton>
                <RepeatButton Background="#273646"
                              Command="{x:Static Slider.IncreaseLarge}"
                              Style="{StaticResource SettingsSliderRepeatButton}" />
              </primitives:Track.IncreaseRepeatButton>
            </primitives:Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="#A6B1BE" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemChrome"
                  Background="{TemplateBinding Background}"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
              <Setter Property="Foreground" Value="#F4F7FB" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemChrome" Property="Background" Value="#23472A" />
              <Setter Property="Foreground" Value="#F4F7FB" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemChrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBox" TargetType="ComboBox">
    <Setter Property="Width" Value="152" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="Background" Value="{StaticResource SettingsControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,0,12,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle"
                          Background="Transparent"
                          BorderThickness="0"
                          Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="SelectChrome"
                          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="16,0,12,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        VerticalAlignment="Center" />
                      <controls:AppIcon Grid.Column="1"
                                        Data="{StaticResource Icon.ChevronRight}"
                                        RenderMode="Stroke"
                                        Size="15"
                                        Foreground="#A6B1BE" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="SelectChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
                      <Setter TargetName="SelectChrome" Property="BorderBrush" Value="#425464" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="SelectChrome" Property="BorderBrush" Value="{StaticResource SettingsFocusBrush}" />
                      <Setter TargetName="SelectChrome" Property="BorderThickness" Value="2" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   PopupAnimation="Fade">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="320"
                      Margin="0,4,0,0"
                      Padding="7"
                      Background="{StaticResource SettingsEmphasisSurfaceBrush}"
                      BorderBrush="#425464"
                      BorderThickness="1"
                      CornerRadius="11">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="28" Opacity="0.4" ShadowDepth="10" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource SettingsFocusBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsButton" TargetType="Button">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="MinWidth" Value="108" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Background" Value="{StaticResource SettingsControlBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonChrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="21"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SettingsHoverBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#425464" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonChrome" Property="Background" Value="#111923" />
              <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="Background" Value="{StaticResource SettingsAccentBrush}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SettingsAccentHoverBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource SettingsAccentHoverBrush}" />
              <Setter Property="Foreground" Value="#071008" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True" />
                <Condition Property="Background" Value="{StaticResource SettingsAccentBrush}" />
              </MultiTrigger.Conditions>
              <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SettingsAccentPressedBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource SettingsAccentPressedBrush}" />
              <Setter TargetName="ButtonChrome" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="#071008" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource SettingsFocusBrush}" />
              <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.42" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsButtonIcon"
         TargetType="{x:Type controls:AppIcon}"
         BasedOn="{StaticResource {x:Type controls:AppIcon}}">
    <Setter Property="Size" Value="20" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
  </Style>

  <Style x:Key="SettingsHeaderBackButton"
         TargetType="Button"
         BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinWidth" Value="38" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="SettingsPrimaryButton"
         TargetType="Button"
         BasedOn="{StaticResource SettingsButton}">
    <Setter Property="MinWidth" Value="126" />
    <Setter Property="Background" Value="{StaticResource SettingsAccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
    <Setter Property="Foreground" Value="#071008" />
  </Style>

  <Style x:Key="SettingsDangerButton"
         TargetType="Button"
         BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Background" Value="{StaticResource SettingsDangerSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="#763640" />
    <Setter Property="Foreground" Value="#FFADB5" />
  </Style>

  <Style x:Key="SettingsStatusBadge" TargetType="Border">
