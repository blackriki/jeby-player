  <Style x:Key="CardOverlayPlayButton" TargetType="Button">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#E6101721" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F4F7FB" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Panel.ZIndex" Value="20" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="PlayChrome"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="24">
            <controls:AppIcon Data="{StaticResource Icon.Play}"
                              RenderMode="Fill"
                              Size="20"
                              Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="PlayChrome" Property="Background" Value="#F052B54B" />
              <Setter TargetName="PlayChrome" Property="BorderBrush" Value="#F078D36F" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="PlayChrome" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="PlayChrome" Property="BorderBrush" Value="#78D36F" />
              <Setter TargetName="PlayChrome" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="PlayChrome" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

