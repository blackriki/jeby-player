              <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#2B3846" />
              <Setter Property="Foreground" Value="#647181" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
