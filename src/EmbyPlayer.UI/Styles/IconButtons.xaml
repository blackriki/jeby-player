<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EmbyPlayer.UI.Controls">
  <Style TargetType="{x:Type controls:AppIcon}">
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="StrokeThickness" Value="1.9" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:AppIcon}">
          <Viewbox Width="{TemplateBinding Size}"
                   Height="{TemplateBinding Size}"
                   Stretch="{TemplateBinding Stretch}"
                   SnapsToDevicePixels="True"
                   x:Name="IconViewbox">
            <Grid x:Name="IconCanvas"
                  Width="24"
                  Height="24"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="True">
              <Path x:Name="FillPath"
                    Data="{TemplateBinding Data}"
                    Fill="{TemplateBinding Foreground}"
                    Stretch="None"
                    IsHitTestVisible="False" />
              <Path x:Name="StrokePath"
                    Data="{TemplateBinding Data}"
                    Fill="Transparent"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="{TemplateBinding StrokeThickness}"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    Stretch="None"
                    Visibility="Collapsed"
                    IsHitTestVisible="False" />
            </Grid>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="RenderMode" Value="Stroke">
              <Setter TargetName="FillPath" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="StrokePath" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="RenderMode" Value="Fill">
              <Setter TargetName="FillPath" Property="Visibility" Value="Visible" />
              <Setter TargetName="StrokePath" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SolidActionIcon" TargetType="{x:Type controls:AppIcon}"
         BasedOn="{StaticResource {x:Type controls:AppIcon}}">
    <Setter Property="RenderMode" Value="Fill" />
    <Setter Property="Size" Value="18" />
  </Style>

  <Style x:Key="MediaRowArrowButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Background" Value="#CC15181E" />
    <Setter Property="BorderBrush" Value="#66303640" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Opacity" Value="0.55" />
    <Setter Property="Panel.ZIndex" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ArrowChrome"
                  Width="{TemplateBinding Width}"
                  Height="{TemplateBinding Height}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="21">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,-3,0,0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ArrowChrome" Property="Background" Value="#EE232832" />
              <Setter TargetName="ArrowChrome" Property="BorderBrush" Value="#AA52B54B" />
              <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ArrowChrome" Property="BorderBrush" Value="#78D36F" />
              <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ArrowChrome" Property="Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MediaSurfaceCardButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="CardRoot">
            <controls:RoundedClipBorder x:Name="CardChrome"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
              <Border.Background>
                <SolidColorBrush x:Name="CardBackgroundBrush" Color="#151D27" />
              </Border.Background>
              <Border.BorderBrush>
                <SolidColorBrush x:Name="CardBorderBrush" Color="#00000000" />
              </Border.BorderBrush>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </controls:RoundedClipBorder>
            <Border x:Name="CardFocusRing"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="10"
                    IsHitTestVisible="False" />
            <Border x:Name="CardPressedOverlay"
                    Background="#18FFFFFF"
                    CornerRadius="10"
                    Opacity="0"
                    IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="CardBackgroundBrush"
                                    Storyboard.TargetProperty="Color"
                                    To="#1D2834"
                                    Duration="0:0:0.14" />
                    <ColorAnimation Storyboard.TargetName="CardBorderBrush"
                                    Storyboard.TargetProperty="Color"
                                    To="#38FFFFFF"
                                    Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <ColorAnimation Storyboard.TargetName="CardBackgroundBrush"
                                    Storyboard.TargetProperty="Color"
                                    To="#151D27"
                                    Duration="0:0:0.14" />
                    <ColorAnimation Storyboard.TargetName="CardBorderBrush"
                                    Storyboard.TargetProperty="Color"
                                    To="#00000000"
                                    Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="CardFocusRing" Property="BorderBrush" Value="#78D36F" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="CardPressedOverlay" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="CardRoot" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

